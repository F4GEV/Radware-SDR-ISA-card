#define MAX_MORSE 100

.MODULE/RAM modes;

#define MSG_PLOT_USB_SPECTRUM   101
#define MSG_PLOT_LSB_SPECTRUM   102
#define MSG_PLOT_LSB_TIME       103
#define MSG_PLOT_USB_TIME       104
#define MSG_SMETER_LEVEL        105
#define MSG_MORSE_NEXT_CHAR     110
#define MSG_MORSE_END_MORSE     111
#define MSG_FREQ_CAL            112
#define MSG_AGC_ANALOG          113
#define msg_RTTY                116

.VAR/DM/RAM  Input_Position;
.VAR/DM/RAM  Output_Position;
.VAR/DM/RAM  Buffer_Position;
.VAR/DM/RAM  RTTY_Data[200];
.VAR/DM/RAM  RTTY_Data_Pnt;
.VAR/DM/RAM  RTTY_Data_Count;
.VAR/DM/RAM  Calc_Buffer[256];
.VAR/DM/RAM  Calc_Buffer2[256];
.VAR/DM/RAM  Calc_Buffer3[256];
.VAR/DM/RAM  AnalogMessage[3];
.var/dm/ram last_data;
.var/dm/ram smeter;
.var/dm/ram smeter_time;
.var/dm/ram AM_Tune;
.VAR/DM/RAM Noise_Level;

.ENTRY calculate_modes;

.GLOBAL Noise_Level;
.GLOBAL smeter_time;
.GLOBAL Input_Position;
.GLOBAL Buffer_Position;
.GLOBAL RTTY_Data;
.GLOBAL RTTY_Data_Pnt;
.GLOBAL RTTY_Data_Count;

.external Adjust_I_;
.external Center_;
.external Convert_RTTY_To_Bits_;
.external Convert_RTTY_To_Bits_2;
.external Copy_Data_256_;
.external Costas;
.external Average;
.external HighLow;
.external Decimate_And_Filter_;
.external Deemphisize;
.external delayLine;
.external DitLength;
.external Emphisize;
.external Highpass_Both_;
.external Hilbert2;
.external Hilbert_And_Delay_;
.external Filter_60_Hz_;
.external Filter_Both_;
.external FM_RTTY_;
.external FM2_;
.external FreqCal2_;
.external GetVolume_;
.external Make_SSB_;
.external Make_SSB_FM_;
.external MultiplyAllByVolume_;
.external Mute_Samples_;
.external Noise_AGC_;
.external PSK_;
.external Remove_LSB_;
.external Remove_USB_;
.external RestoreVolume_;
.external Transfer_Data;
.external FillSin_;
.external MySetTone_;
.external AGC_;
.external send_msg;
.external send_important_msg;
.external out_message_number;
.external sFilter;
.external SlowAGC_;
.external ClearOffset_;
.external AGC_On_;
.external squelch;
.external TalkOn_;
.external dolsbfft_;
.external dousbfft_;
.external USB_BUFFER_;
.external LSB_BUFFER_;
.external data_ready;
.external delayLine3;
.external fft_time;
.external input_data;
.external AGC_Up;
.external AGC_Down;
.external play_voice;
.external output_data;
.external SendingMorse;
.external AnalogAGC;
.external mode;
.external CurrentIFGain;
.external PlotUSBS;
.external PlotLSBS;
.external PlotUSBT;
.external PlotLSBT;
.external Morse;
.external MorsePosition;
.external NewSetTone;
.external ChangeVolume_;
.external important_message_number;
.external put_word;

calculate_modes: call Check_Tone_Control;
                 call Calculate_Input_Position;
                 call check_for_lsbt;
                 call check_for_morse;
                 call find_mode;
                 AY1 = ^Calc_Buffer;
                 AR = dm(Output_Position);
                 call Copy_Data_256_;
                 call check_for_Analog_AGC;
                 call check_for_plots;
                 call update_buffer_pos;
                 rts;

Check_Tone_Control: ax0 = dm(NewSetTone);
                    ar = pass ax0;
                    if lt jump no_new_tone;
                    call MySetTone_;
                    ax0 = dm(NewSetTone);
                    ar = not ax0;
                    dm(NewSetTone) = ar;
no_new_tone:        rts;

check_for_Analog_AGC: ax0 = dm(AGC_On_);
                      ar = pass ax0;
                      if eq jump no_analog_agc;
                      ax0 = dm(TalkOn_);
                      ar = pass ax0;
                      if ne jump no_analog_agc;
                      ax0 = dm(AnalogAGC);
                      ay0 = 1;
                      ar = ax0+ay0;
                      if lt jump Turn_Down_AGC;
                      ay0 = 64;
                      ar = ax0-ay0;
                      if gt jump Turn_Up_AGC;
no_analog_agc:        rts;

Turn_Down_AGC:    ay0 = dm(CurrentIFGain);
                  ax1 = -1;
                  ar = pass ay0;
                  if eq jump Turn_Down_10_DB;
                  ax1 = 0;
                  ar = ay0-1;
                  ay0 = ar;
send_new_gain:    dm(AnalogMessage)=ay0;
                  call GetVolume_;
                  dm(AnalogMessage+1)=ar;
                  dm(AnalogMessage+2)=ax1;
                  i0 = ^AnalogMessage;
                  ax1 = MSG_AGC_ANALOG;
                  ay1 = 3;
                  call send_important_msg;
                  rts;

Turn_Down_10_DB:  ax0 = dm(AGC_Down);
                  ar = pass ar;
                  if ne jump send_new_gain;
                  rts;   /* minimum gain already */

Turn_Up_10_DB:    ax0 = dm(AGC_Up);
                  ar = pass ar;
                  if ne jump send_new_gain;
                  rts;   /* maximum gain already */

Turn_Up_AGC:      ay0 = dm(CurrentIFGain);
                  ax1 = 1;
                  ax0 = 15;
                  ar = ay0-ax0;
                  if eq jump send_new_gain;
                  ax1 = 0;
                  ar = ay0+1;
                  ay0 = ar;
                  jump send_new_gain;

check_for_lsbt:   ax0 = dm(play_voice);
                  ar = pass ax0;
                  if ne jump no_lsbt;
                  ax0 = dm(mode);
                  ay0 = 4;
                  ay1 = 128;
                  ar = ax0-ay0;
                  if ne jump check_128_lsb;
                  ay1 = 128;   /* 192 */
check_128_lsb:    ax0 = dm(Buffer_Position);
                  ar = ax0-ay1;
                  if ne jump buffer_not_ready;
                  ax0 = dm(fft_time);
                  ay0 = 3;
                  ar = ax0-ay0;
                  ar = ar-ay0;
                  if eq jump plot_LSB_time;
no_lsbt:          rts;

check_for_plots:  ax0 = dm(play_voice);
                  ar = pass ax0;
                  if ne jump check_play_voice;
                  ax0 = dm(mode);
                  ay0 = 4;
                  ay1 = 128;
                  ar = ax0-ay0;
                  if ne jump check_128;
                  ay1 = 128; /* 192 */
check_128:        ax0 = dm(Buffer_Position);
                  ar = ax0-ay1;
                  if ne jump buffer_not_ready;
                  ay0 = dm(fft_time);
                  ar = ay0-1;
                  dm(fft_time) = ar;
                  if eq jump plot_LSB_spectrum;
                  ay0 = 3;
                  ar = ar-ay0;
                  if eq jump plot_USB_spectrum;
                  ar = ar-ay0;
                  if eq jump plot_USB_time;
buffer_not_ready: rts;

check_play_voice: rts;   /* must do */

plot_LSB_spectrum: ar = 26;
                   dm(fft_time) = ar;
                   ar = dm(PlotLSBS);
                   ar = pass ar;
                   if eq jump no_plot;
                   call dolsbfft_;
                   i0 = ar;
                   ax1 = MSG_PLOT_LSB_SPECTRUM;
                   ay1 = 256;
                   call send_important_msg;
                   rts;

plot_USB_spectrum: ar = dm(PlotUSBS);
                   ar = pass ar;
                   if eq jump no_plot;
                   call dousbfft_;
                   i0 = ar;
                   ax1 = MSG_PLOT_USB_SPECTRUM;
                   ay1 = 256;
                   call send_important_msg;
no_plot:           rts;

plot_USB_time:     ar = dm(PlotUSBT);
                   ar = pass ar;
                   if eq jump no_plot;
                   i0 = ^USB_BUFFER_;
                   ax1 = MSG_PLOT_USB_TIME;
                   ay1 = 256;
                   call send_important_msg;
                   rts;

plot_LSB_time:     ar = dm(PlotLSBT);
                   ar = pass ar;
                   if eq jump no_plot;
                   i0 = ^LSB_BUFFER_;
                   ax1 = MSG_PLOT_LSB_TIME;
                   ay1 = 256;
                   call send_important_msg;
                   rts;

check_for_morse: ay0 = dm(SendingMorse);
                 ar = ay0-1;
                 if gt jump morse_all;
                 if lt jump no_morse;
                 AR = dm(Input_Position);
                 call FillSin_;
                 I0 = dm(Input_Position);
                 M0 = 0;
                 M1 = 1;
                 L0 = 0;
                 cntr = 128;
                 ay0 = 10;
                 ax0 = 0;
                 ax1 = dm(DitLength);
                 ay1 = dm(MorsePosition);
                 ar = dm(Morse);
                 do morse_loop until ce;
                 ar = ar-ay0;
                 if gt jump keep_sine;
                 dm(I0,M0) = ax0;
keep_sine:       ar = dm(I0,M1);
                 dm(I0,M1) = ar;
                 ar = ay1+1;
                 ay1 = ar;
                 ar = ay1-ax1;
                 if lt jump morse_loop;
                 dm(MorsePosition)=ay1;
                 ay1 = dm(Morse);
                 ax0 = 10;
                 ar = ay1-ax0;
                 if lt jump inc_morse;
                 ar = ay1-1;
                 ay1 = ar;
                 jump dec_morse;
inc_morse:       ar = pass ay1;
                 if eq jump dec_morse;   /* abort if end of string */
                 ar = ay1+1;
                 ay1 = ar;
dec_morse:       dm(Morse) = ay1;
                 ar = ay1-ax0;
                 if ne jump dont_delete;
                 call Delete_Morse;
dont_delete:     ay1 = 0;
                 ay0 = 10;
                 ax0 = 0;
morse_loop:      ar = dm(Morse);
                 dm(MorsePosition)=ay1;
no_morse:        rts;

Delete_Morse: I0 = ^Morse;
              I1 = ^Morse+1;
              M0 = 1;
              L0 = 0;
              L1 = 0;
              cntr = MAX_MORSE-1;
              do delete_loop until ce;
              ar = dm(I1,M1);
delete_loop:  dm(I0,M1) = ar;
              ay1 = 0;
              dm(I0,M1) = ay1;
              ay1 = dm(Morse);
              ar = pass ay1;
              if eq jump send_end_morse;
              ay1 = dm(Morse+1);
              ar = pass ay1;
              if eq jump send_next_char;
              rts;

send_end_morse: ax1 = MSG_MORSE_END_MORSE;
                ay1 = 0;
                dm(SendingMorse)=ay1;
                call send_important_msg;
                rts;

send_next_char: ax1 = MSG_MORSE_NEXT_CHAR;
                ay1 = 0;
                call send_important_msg;
                rts;

morse_all: AR = dm(Input_Position);
           call FillSin_;
           rts;

find_mode:   ar = dm(TalkOn_);
             ar = pass ar;
             if ne jump find_xmit_mode;
             ax0 = dm(mode);
             ar = pass ax0;
             if eq jump AM_Recieve;
             ay0 = 10;
             ar = ax0-ay0;
             if eq jump AM_Recieve;
             ay0 = 4;
             ar = ax0-ay0;
             if eq jump FM_Recieve;
             ay0 = 6;
             ar = ax0-ay0;
             if eq jump Data_Recieve;
             ay0 = 7;
             ar = ax0-ay0;
             if eq jump Data_Recieve;
             ay0 = 8;
             ar = ax0-ay0;
             if eq jump SSB_Recieve;  /* FM allready converted to AM */

/*Noise_Cancel: AR = dm(Input_Position);
              call Adjust_I_;
              CNTR = 128;
              i2 = dm(Input_Position);
              i3 = ^Calc_Buffer;
              l2 = 0;
              l3 = 0;
              m2 = 0;
              m3 = 1;
              do noise_loop until CE;
              ar = dm(I2,M3);
              sr = ASHIFT AR BY -1 (HI);
              ax0 = SR1;
              AR = dm(I2,M3);
              SR = ASHIFT AR BY -1 (HI);
              AY0 = SR1;
              AR = AX0+AY0;
              call delayLine3;
              dm(I3,M2) = AR;
              AR = AX0-AY0;
              call Hilbert2;
              AX0 = DM(I3,M2);
              AY0 = AR;
              AR = AX0 + AY0;
              AR = AX0;
              DM(I3,M3) = AR;
              AR = AX0 - AY0;
              AR = AY0;
noise_loop:   dm(I3,M3) = AR;
              rts;
*/
SSB_Recieve: AR = dm(Input_Position);
             call Adjust_I_;
             AR = dm(Input_Position);
             AY1 = ^Calc_Buffer;
             call Hilbert_And_Delay_;
            ax0 = dm(mode);
            ay0 = 8;
            ar = ax0-ay0;
            if ne jump No_SSB_Squelch;
            AR = ^Calc_Buffer;
            call Noise_AGC_;
            dm(Noise_Level) = AR;
/*            call GetVolume_;
            dm(smeter) = ar;
            call send_smeter;
            call GetVolume_;
*/            ay1 = dm(squelch);
            ar = ar-ay1;
            if ge jump Mute_FM;
            AR = ^Calc_Buffer;
            call Deemphisize;
            call RestoreVolume_;
No_SSB_Squelch: AR = ^Calc_Buffer;
             call Filter_Both_;
             AY1 = ^LSB_BUFFER_;
             AX1 = dm(Buffer_Position);
             ar = ax1+ay1;
             ay1 = ar;
             AR = ^Calc_Buffer;
             call Make_SSB_;
             AY1 = ^USB_BUFFER_;
             AX1 = dm(Buffer_Position);
             ar = ax1+ay1;
             ay1 = ar;
             AY0 = ^Calc_Buffer;
             ar = ay0+1;
             call Make_SSB_;
             ay0 = dm(mode);
             ar = ay0-1;
             if eq jump LSB_Recieve;
             ay0 = ar;
             ar = ay0-1;
             if eq jump USB_Recieve;
             ay0 = 2;
             ar = ar-ay0;
             if eq jump USB_Recieve;   /* CW */
             jump ISB_Recieve;
LSB_Recieve: AR = ^Calc_Buffer;
             call Remove_USB_;
             jump ISB_Recieve;
USB_Recieve: AR = ^Calc_Buffer;
             call Remove_LSB_;
ISB_Recieve: AR = ^Calc_Buffer;
             call Filter_60_Hz_;
             call which_agc;
             AR = ^Calc_Buffer;
             call MultiplyAllByVolume_;
             rts;
/*
Third_Method: AR = dm(Input_Position);
              call Adjust_I_;
              AR = dm(Input_Position);
              AY1 = ^Calc_Buffer;
              call Hilbert_And_Delay_;
             ax0 = dm(mode);
             ay0 = 8;
             ar = ax0-ay0;
             if ne jump No_SSB_Squelch;
             AR = ^Calc_Buffer;
             call Noise_AGC_;
             dm(Noise_Level) = AR;
             ay1 = dm(squelch);
             ar = ar-ay1;
             if ge jump Mute_FM;
             AR = ^Calc_Buffer;
             call Deemphisize;
No_SSB_Squelch: AR = ^Calc_Buffer;
              call Filter_Both_;
              AY1 = ^LSB_BUFFER_;
              AX1 = dm(Buffer_Position);
              ar = ax1+ay1;
              ay1 = ar;
              AR = ^Calc_Buffer;
              call Make_SSB_;
              AY1 = ^USB_BUFFER_;
              AX1 = dm(Buffer_Position);
              ar = ax1+ay1;
              ay1 = ar;
              AY0 = ^Calc_Buffer;
              ar = ay0+1;
              call Make_SSB_;
              ay0 = dm(mode);
              ar = ay0-1;
              if eq jump LSB_Recieve;
              ay0 = ar;
              ar = ay0-1;
              if eq jump USB_Recieve;
              ay0 = 2;
              ar = ar-ay0;
              if eq jump USB_Recieve;
              jump ISB_Recieve;
LSB_Recieve:  AR = ^Calc_Buffer;
              call Remove_USB_;
              jump ISB_Recieve;
USB_Recieve:  AR = ^Calc_Buffer;
              call Remove_LSB_;
ISB_Recieve:  AR = ^Calc_Buffer;
              call Filter_60_Hz_;
              AR = ^Calc_Buffer;
              call MultiplyAllByVolume_;
              rts;
*/
AM_Recieve:  AR = dm(Input_Position);
             AY1 = ^Calc_Buffer;
             call Hilbert_And_Delay_;
             ar = ^Calc_Buffer3;
             ay1 = dm(Input_Position);
             call Copy_Data_256_;
            ar = ^Calc_Buffer3;
            call Highpass_Both_;
            ar = ^Calc_Buffer3;
            ay1 = ^Calc_Buffer2;
            call FM2_;
/*            ar = ^Calc_Buffer2;
            call Decimate_And_Filter_;
*/             AY1 = ^LSB_BUFFER_;
             AX1 = dm(Buffer_Position);
             ar = ax1+ay1;
             ay1 = ar;
             AR = dm(Input_Position);
             call Make_SSB_;
             AY1 = ^USB_BUFFER_;
             AX1 = dm(Buffer_Position);
             ar = ax1+ay1;
             ay1 = ar;
             AY0 = dm(Input_Position);
             ar = ay0+1;
             call Make_SSB_;
             AR = ^Calc_Buffer;
             call Filter_Both_;
             ar = dm(mode);
             if eq jump AM_LSB;
             AR = ^Calc_Buffer;
             call Remove_USB_;
             jump AM_USB;
AM_LSB:      AR = ^Calc_Buffer;
             call Remove_LSB_;
AM_USB:      call which_agc;
             AR = ^Calc_Buffer;
             call MultiplyAllByVolume_;
             AR = dm(play_voice);
             AR = pass ar;
             if ne jump dont_tune;
             AR = ^Calc_Buffer;
             call Filter_60_Hz_;
/*             AR = ^USB_BUFFER_;
             call Center_;
             MX0 = AR;
             AR = ^LSB_BUFFER_;
             call Center_;
             MY0 = 0x8000;
             MR = AR*MY0 (UU);
             MR = MR-MX0*MY0 (UU);
*/
             dm(AM_Tune) = MR1;
            ar = ^Calc_Buffer2+1;
            ay1 = ^USB_BUFFER_;
            call Make_SSB_FM_;
            ar = ^Calc_Buffer2+1;
            ay1 = ^USB_BUFFER_+128;
            call Make_SSB_FM_;
            AR = ^Calc_Buffer2+1;  
!            call Average;
            call HighLow;
           AR = -AR;
           dm(AM_Tune) = AR;
             ax1 = MSG_FREQ_CAL;
             ay1 = 1;
             i0 = ^AM_Tune;
             call send_important_msg;
dont_tune:   rts;

FM_Recieve:  ar = ^Calc_Buffer2;
             ay1 = dm(Input_Position);
             call Copy_Data_256_;
/*             i0 = dm(Input_Position);
             ar = dm(I0,M0);
             dm(Calc_Buffer2) = ar;
*/             ar = ^Calc_Buffer2;
             call AGC_;
             call GetVolume_;
             dm(smeter) = ar;
             call send_smeter;
             call GetVolume_;
             ay0 = 0x8000;
             ar = ar+ay0;
             ay1 = dm(squelch);
             ar = ar-ay1;
             if lt jump Mute_FM;
             call RestoreVolume_;
             ar = ^Calc_Buffer2;
             call Highpass_Both_;
             ar = ^Calc_Buffer2;
             ay1 = ^Calc_Buffer;
             call FM2_;
             ar = ^Calc_Buffer+1;
             ay1 = ^USB_BUFFER_;
             call Make_SSB_FM_;
             ar = ^Calc_Buffer;
             call Decimate_And_Filter_;
             ar = ^Calc_Buffer;
             call MultiplyAllByVolume_;
             ar = ^Calc_Buffer+1;
             ay1 = ^LSB_BUFFER_;
             call Make_SSB_FM_;
             rts;
Mute_FM:     call RestoreVolume_;
             ar = ^Calc_Buffer;
             call Mute_Samples_;
             rts;

Data_Recieve:   ar = ^Calc_Buffer2;
                ay1 = dm(Input_Position);
                call Copy_Data_256_;
                ar = ^Calc_Buffer2;
                call AGC_;
                call GetVolume_;
                dm(smeter) = ar;
                call send_smeter;
                call GetVolume_;
                ay1 = dm(squelch);
                ar = ar-ay1;
                if lt jump Mute_FM;
                call RestoreVolume_;
                ar = ^Calc_Buffer2;
!                call Highpass_Both_;
                ar = ^Calc_Buffer2;
                ay1 = ^Calc_Buffer;
                ax0 = dm(mode);
                ay0 = 6;
                af = ax0-ay0;
                if gt jump PSK_Recieve;
                call FM2_;
                jump FSK_Recieve;
PSK_Recieve:    call PSK_;
FSK_Recieve:    ar = ^Calc_Buffer;
                call MultiplyAllByVolume_;
                ar = ^Calc_Buffer;
                call FM_RTTY_;
/*                ax0 = dm(RTTY_Data_Pnt);
                ay0 = ^RTTY_Data+150;
                ar = ax0-ay0;
*/              ax0 = dm(RTTY_Data_Count);
                ay0 = 150;
                ar = ax0-ay0;
                if ge jump excess_data;
                ar = ^Calc_Buffer+1;
/*                ay1 = dm(RTTY_Data_Pnt);
*/            ax0 = ^RTTY_Data+1;
              ay0 = dm(RTTY_Data_Count);
              ar = ax0+ay0;
              ay1 = ar;
               ay1 = ^RTTY_Data+1;
              ar = ^Calc_Buffer+1;
                call Convert_RTTY_To_Bits_2;
/*                ay1=dm(RTTY_Data_Pnt);
*/             ay1 = dm(RTTY_Data_Count);
!                ar = ar+ay1;
               dm(RTTY_Data_Count) = ar;
/*                dm(RTTY_Data_Pnt) = ar;
*/excess_data:    ar = dm(out_message_number);
                ar = pass ar;
                if ne jump dont_send_rtty;
/*                ax1 = dm(RTTY_Data_Pnt);
                ay1 = ^RTTY_Data-1;
                ar = ax1-ay1;
*/              ay1 = dm(RTTY_Data_Count);
                ar = ay1+1;
                ay1 = ar;
                ar = ay1+1;
                ay1 = ar;
                ar = ay1-1;

                dm(RTTY_Data) = ar;
/*                AR = dm(Transfer_Data);
                dm(RTTY_Data+1) = AR;
*/              ay0 = ^RTTY_Data;
              ar = ar+ay0;
              I0 = ar;
/*                I0 = dm(RTTY_Data_Pnt);
*/                ax0 = 0;
                DM(I0,M0) = ax0;
                DM(RTTY_Data+150) = ax0;
                ax1 = msg_RTTY;
                i0 = ^RTTY_Data;
                call send_msg;
                ar = 0;
                dm(RTTY_Data_Count) = ar;
                ar = ^RTTY_Data+1;
                dm(RTTY_Data_Pnt) = ar;
dont_send_rtty: ar = ^LSB_BUFFER_;
                ay0 = dm(Buffer_Position);
                ar = ar + ay0;
                ay1 = ar;
                ar = ^Calc_Buffer+1;
                call Make_SSB_FM_;
                rts;

find_xmit_mode: ar = dm(mode);
                ar = pass ar;
                if eq jump Xmit_AM;
                ay0 = 2;
                ar = ar-ay0;
                if lt jump Xmit_LSB;
                if eq jump Xmit_USB;
                ar = ar-ay0;
                if lt jump Xmit_ISB;
                jump Xmit_USB;

Xmit_AM:   AR = ^Calc_Buffer;
           AY1 = DM(Input_Position);
           call Copy_Data_256_;
           i0 = dm(Input_Position);
           ar = dm(I0,M0);
           dm(Calc_Buffer) = ar;
           ar = dm(SendingMorse);
           ar = pass ar;
           if ne jump AM_Yes_Morse;
           AR = ^Calc_Buffer;
           call Filter_60_Hz_;
Xmit_AM3:  ar = dm(AGC_On_);
           ar = pass ar;
           if ne jump Xmit_AM2;
           AR = ^Calc_Buffer;
           call AGC_;
Xmit_AM2:  AR = ^Calc_Buffer;
           call MultiplyAllByVolume_;
           rts;
AM_Yes_Morse: AR = ^Calc_Buffer;
              call Filter_Both_;
              jump Xmit_AM3;

Xmit_LSB:    DIS M_MODE;
             I2 = dm(Input_Position);
             I1 = ^Calc_Buffer;
             M3 = 0;
             M1 = 1;                    /* sFilter & Delayline will use I0 & M0 */
             M2 = 2;
             L2 = 0;
             L1 = 0;
             CNTR = 128;
             do X_LSB_Loop until CE;
             AR = dm(I2,M3);
             call sFilter;
             dm(I1,M1) = AR;
             AR = dm(I2,M2);
             call delayLine;
X_LSB_Loop:  dm(I1,M1) = AR;
Xmit_SSB:    ar = dm(SendingMorse);
             ar = pass ar;
             if ne jump Yes_Morse;
             ar = ^Calc_Buffer;
             call Filter_60_Hz_;
Yes_Morse:   ar = dm(AGC_On_);
             ar = pass ar;
             if eq jump Xmit_SSB2;
             ar = ^Calc_Buffer;
             call AGC_;
Xmit_SSB2:   ar = ^Calc_Buffer;  /* originally we might have filtered CW as well!*/
             call Filter_Both_;
             ax0 = dm(mode);
             ay0 = 8;
             ar = ax0-ay0;
             if ne jump Not_FM_Xmit;
             ar = ^Calc_Buffer;
             call Emphisize;
Not_FM_Xmit: ar = ^Calc_Buffer;
             call MultiplyAllByVolume_;
             ar = ^Calc_Buffer;
             call Adjust_I_;
             ENA M_MODE;
             rts;

Xmit_USB:    DIS M_MODE;
             I2 = dm(Input_Position);
             I1 = ^Calc_Buffer;
             M3 = 0;
             M1 = 1;                    /* sFilter & Delayline will use I0 & M0 */
             M2 = 2;
             L2 = 0;
             L1 = 0;
             CNTR = 128;
             do X_USB_Loop until CE;
             AR = dm(I2,M3);
             call delayLine;
             dm(I1,M1) = AR;
             AR = dm(I2,M2);
             call sFilter;
X_USB_Loop:  dm(I1,M1) = AR;
             jump Xmit_SSB;

Xmit_ISB:    DIS M_MODE;
             I2 = dm(Input_Position);
             I1 = ^Calc_Buffer;
             M3 = 0;
             M1 = 1;                    /* sFilter & Delayline will use I0 & M0 */
             M2 = 2;
             L2 = 0;
             L1 = 0;
             CNTR = 128;
             do X_ISB_Loop until CE;
             AR = dm(I2,M2);
             dm(I1,M1) = AR;
X_ISB_Loop:  dm(I1,M1) = AR;
             jump Xmit_SSB;



which_agc:    ar = ^Calc_Buffer;
              call AGC_;
              ay0 = dm(AGC_On_);
              ar = ay0-1;
              if le jump not_slow_agc;
              call SlowAGC_;
not_slow_agc: call GetVolume_;
              dm(smeter) = ar;
              ay0 = dm(AGC_On_);
              ar = ay0-1;
              if ge jump not_agc_off;
              call RestoreVolume_;
              call send_smeter;
              rts;
not_agc_off:  call GetVolume_;
              ay0 = 1250;
              ax0 = ar;
              ar = ax0-ay0;
              if lt jump increase_front;
              ay0 = 42500;
              ar = ax0-ay0;
              if gt jump decrease_front;
check_clear:  ay0 = dm(AGC_On_);
              ar = ay0-1;
              if ne jump agc_smeter;
              call ClearOffset_;
agc_smeter:   rts;

increase_front: ay0 = dm(AnalogAGC);
                ar = ay0+1;
                dm(AnalogAGC) = ar;
                jump check_clear;

decrease_front: ay0 = dm(AnalogAGC);
                ar = ay0-1;
                dm(AnalogAGC) = ar;
                jump check_clear;

send_smeter:     ay0 = dm(smeter_time);
                 ar = ay0-1;
                 dm(smeter_time) = ar;
                 if ne jump end_send_smeter;
                 ar = 4;
                 dm(smeter_time) = ar;
                 ax1 = MSG_SMETER_LEVEL;
                 ay1 = 1;
                 i0 = ^smeter;
                 call send_msg;
end_send_smeter: rts;

Calculate_Input_Position: ar = dm(data_ready);
                          ay1 = 1;
                          ar = ar-ay1;
                          if eq jump first_block;
                          ax0 = ^input_data+256;
                          ax1 = ^output_data+256;
                          jump second_block;
first_block:              ax0 = ^input_data;
                          ax1 = ^output_data;
second_block:             dm(Input_Position) = ax0;
                          dm(Output_Position) = ax1;
                          ax0 = 0;
                          dm(data_ready) = ax0;
                          rts;

update_buffer_pos:  ax0 = dm(Buffer_Position);
                    ax1 = dm(mode);
                    ay0 = 4;
                    ay1 = 128;  /*64*/
                    ar = ax1-ay0;
                    if eq jump inc_by_64;
                    ay0 = 6;
                    ar = ax1-ay0;
                    if eq jump inc_by_64;
                    ay0 = 7;
                    ar = ax1-ay0;
                    if eq jump inc_by_64;
                    ay1 = 128;
inc_by_64:          ar = ax0+ay1;
                    ay0 = 256;
                    af = ar-ay0;
                    if ne jump dont_reset_buf_pos;
                    ar = 0;
dont_reset_buf_pos: dm(Buffer_Position) = ar;
                    rts;

.ENDMOD;
