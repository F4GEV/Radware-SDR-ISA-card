		 240	{****************************************************************************
		 241	   *** Autocalibration - Required after reset and when ADC gain is changed
		 242	       1. Mute Left and Right DAC output,AUX1 input, AUX2 input and Dig.Mix
		 243	       2. Set   MCE bit
		 244	       3. Set   ACAL bit
		 245	       4. Clear MCE bit
		 246	       5. wait for ACI bit to go high, then wait for it to go low
		 247	***************************************************************************}
		 248	                                    {NOTE that all inputs still muted}
008B	449000	 249	    ax0 = (IntfConfig_Sel+MCE);     {MCE  set}
008C	900000u	 250	    dm(SP_address_reg) = ax0;
008D	408000	 251	    ax0 = (IntfConfig_Cfg+ACAL);     {ACAL set}
008E	900000u	 252	    dm(SP_data_reg) = ax0;
008F	40B000	 253	    ax0 = TestInit_Sel;
0090	900000u	 254	    dm(SP_address_reg) = ax0;
0091	420004	 255	    ay0 = AutoCALInProgress;
		 256	autocal_w1:                         {wait for ACI == 1}
0092	800000u	 257	    ax0 = dm(SP_data_reg);
0093	23C00F	 258	    ar = ax0 XOR ay0;
0094	180000u	 259	    if EQ jump autocal_w1;
0095	400031	 260	   ax1 = 3;
0096	1C000Fu	 261	   call put_word_;
		 262	autocal_w2:                         {wait for ACI == 0}
0097	800000u	 263	    ax0 = dm(SP_data_reg);
0098	23C00F	 264	    ar = ax0 XOR ay0;
0099	180001u	 265	    if NE jump autocal_w2;
009A	400021	 266	   ax1 = 2;
009B	1C000Fu	 267	   call put_word_;
		 268			       {autocalibrate is done}
009C	340000u	 269	    i0 = ^reg_1848;         {Table contains list of registers to config}
009D	340001u	 270	    i1 = ^reg_1848_init2;   {Table contains initialization values for 1848}
009E	3C0065	 271	    cntr = 6;
009F	14000Eu	 272	    do config_1848 until CE;
00A0	600001	 273	    ax0 = dm(i0,m1);

