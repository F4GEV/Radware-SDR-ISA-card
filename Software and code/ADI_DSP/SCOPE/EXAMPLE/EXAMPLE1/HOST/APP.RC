#include "dlgs.h"


NOISE MENU 
BEGIN
	POPUP "&File"
	BEGIN
		MENUITEM "&Load algorithm", IDM_FILE
		MENUITEM SEPARATOR
		MENUITEM "E&xit", IDM_QUIT
	END

	POPUP "&Config"
	BEGIN
		MENUITEM "Sine&1", IDM_SINE1
		MENUITEM "Sine&2", IDM_SINE2
		MENUITEM "Sine&3", IDM_SINE3
		MENUITEM "C&hirp", IDM_CHIRP
		MENUITEM "&CCITT", IDM_CCITT
		MENUITEM "AD1&84x", IDM_1848_CONFIG
	END

	POPUP "&Details"
	BEGIN
		MENUITEM "&Echo Messages", IDM_ECHO
		MENUITEM "&Dump 1848 Registers", IDM_1848_DUMP
	END

	POPUP "&Plot"
	BEGIN
		MENUITEM "&Plot On",	IDM_PLOT
		MENUITEM SEPARATOR
		MENUITEM "&Frequency", IDM_FREQUENCY, GRAYED, CHECKED
		MENUITEM "&Time", 	  IDM_TIME, GRAYED 
		MENUITEM SEPARATOR
		MENUITEM "&Linear Display", IDM_LINEAR, GRAYED, CHECKED
		MENUITEM "L&og Display", 	IDM_LOG, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "P&ersist", IDM_PERSIST, GRAYED
		MENUITEM "Cle&ar",   IDM_CLEAR, GRAYED
	END

	POPUP "F&ilters"
	BEGIN
		MENUITEM "&Lowpass On",   IDM_LPF 
		MENUITEM "&Hanning On",   IDM_HANN
	END

END

ICON_1 ICON "analog.ico"

DLG_SINE DIALOG 28, 29, 136, 104
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Sine Wave"
FONT 8, "Helv"
BEGIN
	LTEXT "Frequency", MaxFreq, 7, 12, 34, 8
	EDITTEXT Freq, 49, 10, 32, 12, ES_AUTOHSCROLL
	CONTROL "Volume", 104, "STATIC", NOT WS_GROUP, 7, 58, 27, 8
	EDITTEXT Duration, 49, 33, 32, 12, ES_AUTOHSCROLL
	LTEXT "Duration", 106, 7, 35, 37, 8
	DEFPUSHBUTTON "Ok", IDOK, 20, 84, 40, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 76, 84, 40, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	SCROLLBAR Volume, 49, 57, 84, 10
END

DLG_CHIRP DIALOG 39, 20, 160, 100
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Chirp"
FONT 8, "Helv"
BEGIN
	EDITTEXT MinFreq, 63, 9, 32, 12, ES_AUTOHSCROLL
	EDITTEXT MaxFreq, 63, 25, 32, 12, ES_AUTOHSCROLL
	EDITTEXT Speed, 63, 44, 32, 12, ES_AUTOHSCROLL
	SCROLLBAR ChirpVolume, 141, 9, 10, 69, SBS_VERT
	EDITTEXT Duration, 63, 62, 32, 12, ES_AUTOHSCROLL
	PUSHBUTTON "Ok", IDOK, 32, 80, 40, 14
	PUSHBUTTON "Cancel", IDCANCEL, 88, 80, 40, 14
	LTEXT "Min Frequency", 108, 5, 11, 50, 8
	LTEXT "Max Frequency", Volume, 5, 27, 50, 8
	LTEXT "Chirp Speed", 110, 5, 46, 50, 8
	LTEXT "Duration", 111, 5, 64, 50, 8
	LTEXT "Volume", 106, 110, 38, 25, 8
END

DLG_CCITT DIALOG 52, 57, 137, 50
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CCITT Noise"
FONT 8, "Helv"
BEGIN
	SCROLLBAR Volume, 47, 10, 79, 10
	LTEXT "Volume", 102, 11, 11, 29, 8
	DEFPUSHBUTTON "Ok", IDOK, 24, 30, 40, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 73, 30, 40, 14
END


DLG_1848 DIALOG 49, 46, 156, 92
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "1848 Configuration"
FONT 8, "Helv"
BEGIN
	CONTROL "5.51K", SR_5K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP, 14, 13, 39, 10
	CONTROL "6.61K", SR_6K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE, 14, 23, 39, 10
	CONTROL "8K", SR_8K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE, 14, 33, 39, 10
	CONTROL "9.6K", SR_9_6K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE, 14, 43, 39, 10
	CONTROL "11.02K", SR_11K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE, 14, 53, 39, 10
	CONTROL "16K", SR_16K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE, 14, 63, 39, 10
	CONTROL "18.9K", SR_18K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE, 14, 73, 39, 10
	CONTROL "22.05K", SR_22K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE, 53, 13, 39, 10
	CONTROL "27.42K", SR_27K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE, 53, 23, 35, 10
	CONTROL "32K", SR_32K, "Button", BS_AUTORADIOBUTTON, 53, 33, 39, 10
	CONTROL "33.07K", SR_33K, "Button", BS_AUTORADIOBUTTON, 53, 43, 39, 10
	CONTROL "37.8K", SR_37K, "Button", BS_AUTORADIOBUTTON, 53, 53, 39, 10
	CONTROL "44.1K", SR_44K, "Button", BS_AUTORADIOBUTTON, 53, 63, 39, 10
	CONTROL "48K", SR_48K, "Button", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE, 53, 73, 39, 10
	CONTROL "Sample Rate", 125, "BUTTON", BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 6, 2, 92, 85
	CONTROL "Stereo", MODE_STEREO, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 108, 14, 36, 10
	CONTROL "Mono", MODE_MONO, "Button", BS_AUTORADIOBUTTON, 108, 24, 32, 10
	CONTROL "Mode", 110, "BUTTON", BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 103, 2, 45, 38
	DEFPUSHBUTTON "Ok", IDOK, 107, 57, 40, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 107, 73, 40, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
END

STRINGTABLE
BEGIN
  IDS_ERR_CREATE_WINDOW,    "Window creation failed!"
  IDS_ERR_REGISTER_CLASS,   "Error registering window class"
END

DLG_LOADALG DIALOG 38, 56, 130, 81
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Load DSP"
BEGIN
	DEFPUSHBUTTON "Ok", IDOK, 83, 50, 39, 12, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 83, 66, 39, 12, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CTEXT "Choose an algorithm from the list to load", -1, 84, 10, 38, 35, WS_CHILD | WS_VISIBLE | WS_GROUP
	CONTROL "", 101 "LISTBOX", LBS_STANDARD | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 5, 71, 71
END
