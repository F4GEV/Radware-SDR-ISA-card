####################################################
#
#   makealg
#   makefile for building example algorithm
#
#   to build an algorithm:
#       NMAKE -f makealg clean
#       NMAKE -f makealg
#
####################################################

INC     = ..\..\..\include
LIBS    = ..\..\..\bin\psa
OBJS    = alg.obj fft.obj fir.obj gen.obj sin.obj regutil.obj

CLOPT   = -a $(LIBS)\psa.ach -c -I$(INC)
MASMOPT = $(CLOPT)
LINKFILE = linkfile
LINKOPT = -i $(LINKFILE) -a $(LIBS)\psa.ach -e alg -user $(LIBS) -lib -x -g

CC      = G21
ASM     = G21
LINK    = LD21 
SPL     = SPL21

alg.ld: alg.exe
	$(SPL) alg alg -ld

alg.exe: $(OBJS)
	$(LINK) $(LINKOPT)

alg.obj: alg.c $(INC)/dspshell.h $(INC)/dspsdk.h
	$(CC) $(CLOPT) alg.c

fft.obj: fft.dsp cos256.dat hanning.dat
	$(ASM) $(MASMOPT) fft.dsp

fir.obj: fir.dsp fircoeff.dat
	$(ASM) $(MASMOPT) fir.dsp

gen.obj: gen.dsp ccitt.dat
	$(ASM) $(MASMOPT) gen.dsp

sin.obj: sin.dsp
	$(ASM) $(MASMOPT) sin.dsp

regutil.obj: regutil.dsp
	$(ASM) $(MASMOPT) regutil.dsp

clean:
	del *.obj
	del *.exe
	del *.ld


