/*   Volume.dsp  */
/*   Version 0.1 slow AGC prototype */
/*   Version 0.2 faster AGC prototype 6/30/94 */
.MODULE/RAM        VOLUMEMOD;

.VAR/DM/RAM        volume;
.VAR/DM/RAM        reg_l0;
.VAR/DM/RAM        largest;

.ENTRY ChangeVolume_;
.ENTRY GetVolume_;
.ENTRY MultiplyByVolume_;
.ENTRY AGC_;

ChangeVolume_: dm(volume) = AR;
               RTS;

GetVolume_: AR = dm(largest);
            RTS;

MultiplyByVolume_: MY1=dm(volume);
                   MR=AR*MY1(SS);
                   SR=ASHIFT MR1 BY -10 (HI);
                   SR=SR OR LSHIFT MR0 BY -10 (LO);
                   AF=PASS SR1;
                   IF GT JUMP MaxSine;
                   AF = AF+1;
                   IF LT JUMP MinSine;
                   AR=SR0;
                   RTS;
MinSine:           AR=H#8000;
                   RTS;
MaxSine:           AR=H#7FFF;
                   RTS;

AGC_:       dm(reg_l0) = l0;
            i0 = AR;
            l0 = 0;
            m0 = 2;
            CNTR = 128;
            AY0 = 0;
            AY1 = H#FFFF;
            AX0 = dm(i0,m0);
            do AGC_loop UNTIL CE;
            AX1 = H#8000;
            AF = PASS AX1;
            AR = AX0+AF;
            AF = AR - AY0;
            if NOT AC jump not_high;
            AY0 = AR;
not_high:   AF = AR-AY1;
            if AC jump AGC_loop;
            AY1 = AR;
AGC_loop:   AX0 = dm(i0,m0);
            AX0 = AY1;
            AR = AY0-AX0;
            AY0 = AR;
            dm(largest) = AY0;
/*            MY0 = dm(volume);
            MX1 = AY0;
            MR = MX1*MY0(SS);
            SR=ASHIFT MR1 BY -10 (HI);
            SR=SR OR LSHIFT MR0 BY -10 (LO);
            dm(largest) = SR0;  
            AF = PASS SR1;
            if NE jump decrease;
            AY0 = SR0;
            AX0 = H#1000;
            AY1 = dm(volume);
            AR = AY0-AX0;
            if AC jump decrease;
            AR = AY1 +1;
            AY0 = H#7F00;
            AF = AR-AY0;
            if GT jump dont_move;
stay_here:  dm(volume) = AR;
dont_move:  l0 = dm(reg_l0);
            rts;
decrease:   AR = AY1-1;
            if LE jump dont_move;
            jump stay_here;         
*/            AX0 = AY0;
            AF = PASS 0;
            AY1 = H#0020;
            AY0 = H#0000;
            CALL divide;
            dm(volume) = AY0;
            l0 = dm(reg_l0);
            rts;        
    
divide:     DIVS AY1,AX0;
            DIVQ AX0; DIVQ AX0; DIVQ AX0;
            DIVQ AX0; DIVQ AX0; DIVQ AX0;
            DIVQ AX0; DIVQ AX0; DIVQ AX0;
            DIVQ AX0; DIVQ AX0; DIVQ AX0;
            DIVQ AX0; DIVQ AX0; DIVQ AX0;
            RTS;

.ENDMOD;