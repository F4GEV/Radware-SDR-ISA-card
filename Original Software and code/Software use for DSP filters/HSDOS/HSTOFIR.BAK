#include <stdio.h>
#include <math.h>

convert_double(double number,char answer[]);

char answer[20];
FILE *input_stream,*output_stream;
char input_filename[40];
char output_filename[40]="D:CWCONVRT.FIR";
char data[128];
double number;
int output_number;
long total=0;
double amplifier=.5;

main()

{
  printf("Input Filename >");
  gets(input_filename);
  input_filename[strlen(input_filename)-1] = 0;
  output_stream = fopen(output_filename,"w");
  if (!output_stream)
  {
    printf("Error: can open %s.",output_filename);
    abort();
  }
  input_stream = fopen(input_filename,"r");
  if (!input_stream)
  {
    printf("Error: can find %s.",input_filename);
    abort();
  }
  printf("Starting conversion process.\n");
  do
  {
    do
      fgets(data,128,input_stream);
    while (!(data[0] == 'A' && data[1] =='[') && !feof(input_stream));
    if (!feof(input_stream))
    {
      fgets(data,128,input_stream);
      number = atof(data)*amplifier;
      output_number = 65536*number;
      printf("%lf\n%04X00\n",number,output_number);
      if (output_number>0)
        total+=output_number;
      else
        total-=output_number;
      fprintf(output_stream,"%04X00\n",output_number);
    }
  }
  while (!feof(input_stream));
  fclose(input_stream);
  fclose(output_stream);
  printf("final total = %ld, %lX\n",total,total);
  getch();
} 
