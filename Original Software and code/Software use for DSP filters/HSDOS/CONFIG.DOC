    WRITELN(Y,statuscol);
    WRITELN(Y,DRIVE);
    WRITELN(Y,PATH);
    WRITELN(Y,MONO);
    WRITELN(Y,FREQDUALFILE);
    WRITELN(Y,SGCOLOR);
    WRITELN(Y,SGBCOLOR);
    WRITELN(Y,SGGCOLOR);
    WRITELN(Y,IIRFILTERFILE);
    WRITELN(Y,RECURINFILE);
    WRITELN(Y,SCONVUNIT);
    WRITELN(Y,FCONVUNIT);
