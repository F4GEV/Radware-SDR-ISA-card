    WRITELN(Y, MouseType);
    WRITELN(Y, qMous);
    WRITELN(Y, LSI_32_base_addr);
    WRITELN(Y, DAL_base_addr);

    WRITELN(Y, TITCOLOR);
    WRITELN(Y, PHTCOLOR);
    WRITELN(Y, FRTCOLOR);
    WRITELN(Y, SPTCOLOR);
    WRITELN(Y, SGTCOLOR);
    WRITELN(Y, DSTCOLOR);
    WRITELN(Y, SATCOLOR);

    FOR J:=0 TO 11 DO BEGIN
        WRITELN(Y, print_edit[j].field);
        WRITELN(Y, print_edit[j].xstart);
        WRITELN(Y, print_edit[j].ystart);
        WRITELN(Y, print_edit[j].len);
    END;

    WRITELN(Y, print_edit_cursor_pos);

    WRITELN(Y, BB_base_addr);
    WRITELN(Y, module1);
    WRITELN(Y, module2);
    WRITELN(Y, module_cnfg);
    WRITELN(Y, expanded_mem);
    WRITELN(Y, pacer);

    WRITELN(Y, tim_str);
    WRITELN(Y, freq_str);
    WRITELN(Y, phas_str);
    WRITELN(Y, spc_str);
    WRITELN(Y, pwr_str);
    WRITELN(Y, pole_str);
    WRITELN(Y, filt_str);
    WRITELN(Y, fir_str);
    WRITELN(Y, iir_str);

    for i:=0 to 15 do begin
        for j:=0 to 7 do WRITELN(Y, clr_on_black[i,j]);
    end;

    for i:=0 to 15 do begin
        for j:=0 to 7 do WRITELN(Y, clr_on_white[i,j]);
    end;

    WRITELN(Y, max_zoom_slew_rate);
    WRITELN(Y, ARIEL_DATA_OFFSET);    { DSP-16 data memory offset }

    WRITELN(Y, dsplink);              { LSI DSPLINK mask }
    WRITELN(Y, dsplink_type);         { LSI DSPLINK card type }
    WRITELN(Y, dsplink_ofs);          { LSI DSPLINK A/D offset }
    WRITELN(Y, dsplink_ofs_scope);    { LSI DSPLINK scope offset }
    WRITELN(Y, dsplink_ofs_spcana);   { LSI DSPLINK spc. analyzer offset }

    WRITELN(Y, AIC_CTRL_WORD);        { mode word for DSP boards with AIC }

    WRITELN(Y, DSP_32C_base_addr);
    WRITELN(Y, LSI_30_base_addr);

    WRITELN(Y, ATT_CTRL_WORD);

    WRITELN(Y, ATT_base_addr);
    WRITELN(Y, DX2100_seg_addr);
    WRITELN(Y, DX2100_reg_off_addr);
    WRITELN(Y, ASPI_base_addr);
    WRITELN(Y, ASPI_mem_base_addr);
    WRITELN(Y, SON_base_addr);
    WRITELN(Y, NEC_base_addr);
    WRITELN(Y, NEC_mem_base_addr);
    WRITELN(Y, EVM_base_addr);

    DUM:=IORESULT;

    CLOSE(Y);
    DUM:=IORESULT;
{$I+}
end;
