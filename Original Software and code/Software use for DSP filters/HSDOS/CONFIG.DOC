    WRITELN(Y, DT_base_addr);
    WRITELN(Y, LSI_25_base_addr);
    WRITELN(Y, SWDS_base_addr);
    WRITELN(Y, CAC_base_addr);
    WRITELN(Y, ARIEL_base_addr);
    WRITELN(Y, ARIEL_base_mem_addr);
    WRITELN(Y, BB_base_mem_addr);
    WRITELN(Y, proc_type);
    WRITELN(Y, enable_80286);

    for i:=0 to 8 do WRITELN(Y, color_map_color1[i]);
    for i:=0 to 8 do WRITELN(Y, color_map_color2[i]);
    for i:=0 to 8 do WRITELN(Y, color_map_gray[i]);

    WRITELN(Y, AT_binary_offset);

    WRITELN(Y,DSCOLOR);
    WRITELN(Y,DSBCOLOR);
    WRITELN(Y,DSGCOLOR);
    WRITELN(Y,SACOLOR);
    WRITELN(Y,SABCOLOR);
    WRITELN(Y,SAGCOLOR);

    WRITELN(Y, TI_asm_type);
    WRITELN(Y, insert_mode);
    WRITELN(Y, LSI_56_base_addr);
    WRITELN(Y, PLAYBACK_CARD);
    WRITELN(Y, LSI_21_base_addr);
    WRITELN(Y, xfer_scheme);
    WRITELN(Y, OTHER_base_addr);
    WRITELN(Y, OTHER_mem_base_addr);
    WRITELN(Y, ADM_56_base_addr);
    WRITELN(Y, autoscale);
    WRITELN(Y, PC_56_base_addr);
