{
=============================================================================

        This "include" file is used by the example source code files on the
        Hypersignal distribution diskettes that are intended to illustrate
        the use of user-defined external modules.  This file declares all
        of the variables and data structures used by the Hypersignal environ-
        menu configuration save file, and also shows how to read write this
        file.  In addition, all variables are commented, and explained in
        some detail in the cases where it is expected that users may want
        to change some default Hypersignal values, such as 2-D spectrograph
        color schemes, display titles, etc.

                                  Hyperception
                            9550 Skillman LB125 #302
                                Dallas, TX 75243
                                  214-343-8525

=============================================================================

}
CONST   MAX_FIELD=9;
        MAX_FILD=3;
        MAX_ENTREE=10;

        ADM_56_base_addr:    Word=$100; { Motorola development system }
        ARIEL_base_addr:     Word=$33C; { I/O address space }
        ARIEL_base_mem_addr: Word=$D000;{ memory address space }
        ARIEL_data_offset:   Word=$2000;{ default DSP-16 data memory offset }
        ASPI_base_addr:      Word=$220; { ASPI Banshee I/O base address }
        ASPI_mem_base_addr:  Word=$DC00;{ ASPI Banshee memory base address }
        ATT_base_addr:       Word=$33C; { AT&T DSP32C development board addr }
        BB_base_mem_addr:    Word=$D000;{ Burr-Brown PCI2000 system mem addr }
        BB_base_addr:        Word=$300; { Burr-Brown PCI2000 system I/O addr }
        CAC_base_addr:       Word=$300; { CAC DSP32-PC and DSP32C-AT }
        DAL_base_addr:       Word=$1C8; { Digital Audio Labs DRB1 }
        DSP_32C_base_addr:   Word=$300; { Ariel DSP-32C I/O base address }
        DT_base_addr:        Word=$240; { Data Translation 282x series }
        DX2100_seg_addr:     Word=$D000;{ Logabex ADSP-2100 board }
        DX2100_reg_off_addr: Word=0;    { Logabex register offset }
        EVM_base_addr:       Word=$240; { Texas Inst. EVM 'C30 I/O base addr }
        LSI_25_base_addr:    Word=$290; { LSI TMS320C25 system board }
        LSI_56_base_addr:    Word=$290; { LSI DSP56001 system board }
        LSI_21_base_addr:    Word=$290; { LSI ADSP-2100 system board }
        LSI_32_base_addr:    Word=$290; { LSI WE DSP32C system board }
        LSI_30_base_addr:    Word=$290; { LSI TMS320C30 system board }
        OTHER_base_addr:     Word=0;
        OTHER_mem_base_addr: Word=0;
        NEC_base_addr:       Word=$300; { NEC DDK 77220 evb. I/O base addr }
        NEC_mem_base_addr:   Word=$D800;{ NEC DDK 77220 evb. mem base addr }
        PC_56_base_addr:     Word=$340; { Ariel PC-56, DSP-56 (=ARIEL_base_addr
                                          unless multiple boards) }
        SON_base_addr:       Word=$300; { Sonitech Spirit-30 I/O base address }
        SWDS_base_addr:      Word=$D000;{ Texas Inst. TMS320C25 dev. system }


        AIC_CTRL_WORD:       Word=$2E7; { mode control word for DSP boards with
                                          TLC 3204x AIC chip; defaults are:
                                          bits 0,1 = 1,1 (set for mode word)
                                          bit 2 = 1 (ADC filter enabled)
                                          bit 3 = 0 (dig. loopback disabled)
                                          bit 4 = 0 (AUX IN pins disabled)
                                          bit 5 = 1 (synchronous mode)
                                          bits 6,7 = 1,1 (gain set to +-6V,
                                          although some TI data books may
                                          indicate different)
                                          bit 8 = don't care
                                          bit 9 = TLC32040-41: don't care
                                                  TLC32044: D/A sin(x)/x
                                                            filter enabled }

        ATT_CTRL_WORD:       Word=$4000;{ T7520 codec control word for AT&T
                                          DSP32C development board; defaults:
                                          codec connected to DSP32C, no clocks
                                          generated to 34-pin header }

        clr_on_black : array[0..15,0..7] of byte=(  { 'black' screen background (white
                                                      printer background) gray-level
                                                      shading patterns for printer output }
       ( $00, $00, $00, $00, $00, $00, $00, $00 ),  { color index 0 }
       ( $11, $00, $44, $00, $11, $00, $44, $00 ),  {   "     "   1 }
       ( $11, $44, $11, $44, $11, $44, $11, $44 ),
       ( $31, $4C, $13, $C4, $31, $4C, $13, $C4 ),
       ( $55, $AA, $55, $AA, $55, $AA, $55, $AA ),
       ( $CE, $B3, $EC, $3B, $CE, $B3, $EC, $3B ),
       ( $EE, $BB, $EE, $BB, $EE, $BB, $EE, $BB ),
       ( $EE, $FF, $BB, $FF, $EE, $FF, $BB, $FF ),
       ( $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF ),  { color index 8 }

       ( $11, $11, $11, $FF, $11, $11, $11, $FF ),  { Hypersignal doesn't }
       ( $81, $42, $24, $FF, $18, $24, $42, $FF ),  { use patterns 10-16 }
       ( $77, $EE, $77, $EE, $77, $EE, $77, $EE ),  { for printer: maximizes }
       ( $FF, $00, $FF, $00, $FF, $00, $FF, $00 ),  { contrast using lower }
       ( $FF, $11, $FF, $11, $FF, $11, $FF, $11 ),  { number of shades }
       ( $FF, $55, $FF, $55, $FF, $55, $FF, $55 ),
       ( $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF ));

        clr_on_white : array[0..15,0..7] of byte=(  { same as above execpt
                                                      for reverse video output }
       ( $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF ),
       ( $EE, $FF, $BB, $FF, $EE, $FF, $BB, $FF ),
       ( $EE, $BB, $EE, $BB, $EE, $BB, $EE, $BB ),
       ( $CE, $B3, $EC, $3B, $CE, $B3, $EC, $3B ),
       ( $55, $AA, $55, $AA, $55, $AA, $55, $AA ),
       ( $31, $4C, $13, $C4, $31, $4C, $13, $C4 ),
       ( $11, $44, $11, $44, $11, $44, $11, $44 ),
       ( $11, $00, $44, $00, $11, $00, $44, $00 ),
       ( $00, $00, $00, $00, $00, $00, $00, $00 ),

       ( $F0, $0F, $F0, $0F, $F0, $0F, $F0, $0F ),  { see comment above }
       ( $11, $11, $11, $11, $11, $11, $11, $11 ),
       ( $99, $44, $99, $44, $99, $44, $99, $44 ),
       ( $11, $44, $11, $44, $11, $44, $11, $44 ),
       ( $11, $00, $44, $00, $11, $00, $44, $00 ),
       ( $01, $10, $01, $10, $01, $10, $01, $10 ),
       ( $00, $00, $00, $00, $00, $00, $00, $00 ));


TYPE    Str12       = String[12];
        Str25       = String[25];
        Str79       = String[79];

        Carray      = ARRAY[0..2] OF Byte;
        Ediarray    = ARRAY[0..2,0..MAX_ENTREE,0..MAX_FILD] OF Shortint;
        Editarray   = ARRAY[0..2,0..MAX_ENTREE,0..MAX_FIELD] OF String[35];

        graphics_edit = record
             field: String[4];
            xstart: byte;
            ystart: byte;
               len: byte;
        end;
      


{=============== DECLARATIONS REQUIRED FOR CONFIGURATION FILE ==============}

VAR     btmap:                           Byte;
        SER_VAL:                         Byte;
        statuscol:                       Byte;
        mono:                            Byte;

        STATEX,COM_PORT:                 Integer;
        GrafixCard,qGraf:                Integer;
        MouseType,qMous:                 Integer;
        Grfseg:                          Word;
        TIGCOLOR,TICOLOR,TIBCOLOR:       Byte;       { waveform, grid,  and }
        PHGCOLOR,PHCOLOR,PHBCOLOR:       Byte;       { background color for }
        FRGCOLOR,FRCOLOR,FRBCOLOR:       Byte;       { for each plot module }
        SPGCOLOR,SPCOLOR,SPBCOLOR:       Byte;       { 3-D spectrogram }
        SGCOLOR,SGBCOLOR,SGGCOLOR:       Byte;       { 2-D spectrograph }
        DSCOLOR,DSBCOLOR,DSGCOLOR:       Byte;       { digital scope }
        SACOLOR,SABCOLOR,SAGCOLOR:       Byte;       { spectrum analyze }
        TITCOLOR,PHTCOLOR,FRTCOLOR,
        SPTCOLOR,SGTCOLOR,DSTCOLOR,
        SATCOLOR:                        Byte;
        TCOLOR:                          Byte;
        sound_status:                    Byte;    
        cursor:                          Byte;
        autoscale:                       Byte;
        undo_status:                     Byte;
        insert_mode:                     Byte;
        AD_card,DSP_accel:               Integer;
        DSCOPE_card,SPECANA_card:        Integer;
        PLAYBACK_CARD:                   Integer;
        DT_binary_offset:                Integer;
        AT_binary_offset:                Integer;
        proc_type:                       Integer;
        xfer_scheme:                     Byte;
        enable_80286:                    Byte;
        TI_asm_type:                     Byte;
        max_zoom_slew_rate:              Byte;
        color_map_color1,
        color_map_color2,color_map_gray: array[0..8] of byte;

        print_edit:                      array[0..11] of graphics_edit;
        print_edit_cursor_pos:           Byte;

        FREQDUALFILE:                    Str12;
        CONOUTFILE,CONINFILE:            Str12;
        INFILE1,INFILE2,FILTERFILE:      Str12;
        IIRFILTERFILE,RECURINFILE:       Str12;
        DRIVE:                           Str25;
        PATH:                            Str79;
        CONVUNIT,SCONVUNIT,FCONVUNIT:    Integer;

        MEM_STATEY:                      Carray;
        FIELD:                           Editarray;
        FILD:                            Ediarray;

        module1,module2,
        pacer,module_cnfg,
        expanded_mem:                    Integer;   { some Burr-Brown PCI2000 system stuff }

        dsplink,dsplink_type,dsplink_ofs,
        dsplink_ofs_scope,dsplink_ofs_spcana: Integer;


        tim_str,     { Title strings used in graphical displays: modifiable }
        freq_str,    { by user if necessary.} 
        phas_str,
        spc_str,
        pole_str,
        filt_str:                         String[30];
        pwr_str,
        fir_str,
        iir_str:                          String[10];

        ver_str:                          String[25];

{============ read in Hypersignal configuration file HSWORK.CNF ===========}

procedure config_read(var status: integer);
var DUM:    Integer;
    I,J,K:  Integer;
    dumstr: String;
begin
    STATUS:=0;

    ASSIGN(Y, 'HSWORK.CNF');

{$I-}
    RESET(Y);
    IF IORESULT<>0 THEN ASSIGN(Y, 'HSPLUS.CNF');
    RESET(Y);

    IF IORESULT<>0 THEN BEGIN
         CLRSCR;
         GOTOXY(13,10);
         WRITE('COULD NOT FIND HSWORK.CNF OR HSPLUS.CNF FILE !');
         GOTOXY(10,12);
         WRITE('(to create .CNF file, simply run Hypersignal and exit with `E`)');

         CLOSE(Y);
         DUM:=IORESULT;

         STATUS:=1;
         EXIT;
    END;

    READLN(Y, ver_str);              {configuration file version string}

    READLN(Y,STATEX);                {current main menu column (0-2)}
    READLN(Y,MEM_STATEY[0]);         {current menu selection, column 0}
    READLN(Y,MEM_STATEY[1]);         {current menu selection, column 1}
    READLN(Y,MEM_STATEY[2]);         {current menu selection, column 2}
    READLN(Y,FILTERFILE);            {input to convolution, H(n)}
    READLN(Y,CONOUTFILE);            {output from convolution, Y(n); also
                                      input to time display FILENAME2}
    READLN(Y,CONINFILE);             {input to convolution, X(n)}

    FOR I:=0 TO 2 DO BEGIN           {I is menu column index}
         FOR J:=0 TO MAX_ENTREE DO   {J is menu selction index for column}
         BEGIN
              FOR K:=0 TO MAX_FILD DO
              BEGIN
                   READLN(Y,FILD[I,J,K]); {FILD[0]=total number of fields}
              END;        {FILD[1]=starting x screen pos. for first field}
         END;             {FILD[2]=starting y screen pos. for first field}
    END;                  {FILD[3]=current field number (cursor field)}

    FOR I:=0 TO 2 DO BEGIN           {I is menu column index}
         FOR J:=0 TO MAX_ENTREE DO   {J is menu selction index for column}
         BEGIN
              FOR K:=0 TO MAX_FIELD DO     {K is data-entry editor field}
              BEGIN                        { for menu selection J}
                   READLN(Y,FIELD[I,J,K]); {FIELD[K] is Str25 editor for}
              END;                         { field[K]}
         END;
    END;

    READLN(Y,SER_VAL);    {serial port DOS initialization byte, used when per-
                           forming "File Acquisition" from one of four serial
                           ports (COM_PORT variable, below), and in which the
                           8 bits are coded as follows:
                          
                           7 6 5 4 3 2 1 0   bit number; 7 is msb
 
                           x x x             baud rate (0=110, 1=150, 2=300,
                                                        3=600, 4=1200, 5=2400,
                                                        6=4800, 7=9600)
                                 x x         parity (0=none, 1=odd, 3=even)
                                     x       stop bits (0=one, 1=two)
                                       x x   char size (2=7 bits, 3=8 bits) }
                           
    READLN(Y,COM_PORT);   {current assigned serial channel (0-3)}
    READLN(Y,CONVUNIT);   {time display conversion factor: 1E3, 1E6, 1E9}
    READLN(Y,dumstr);     {not used}
    READLN(Y,TICOLOR);    {time display waveform color, 0-15}
    READLN(Y,TIBCOLOR);   {time display background color, 0-15}
    READLN(Y,TIGCOLOR);   {time display grid/axes color, 0-15}
    READLN(Y,PHCOLOR);    {phase display waveform color}
    READLN(Y,PHBCOLOR);   {phase display background color}
    READLN(Y,PHGCOLOR);   {phase display grid/axes color}
    READLN(Y,FRCOLOR);    {magnitude display waveform color}
    READLN(Y,FRBCOLOR);   {magnitude display background color}
    READLN(Y,FRGCOLOR);   {magnitude grid/axes color}
    READLN(Y,SPCOLOR);    {spectrogram waveform color}
    READLN(Y,SPBCOLOR);   {spectrogram grid/axes color}
    READLN(Y,SPGCOLOR);   {spectrogram background color}
    READLN(Y,TCOLOR);     {text color used in all waveform displays}
    READLN(Y,GrafixCard); {reserved: internal graphics driver code}
    READLN(Y,qGraf);      {graphics selection from displayed list}
    READLN(Y,btmap);      {0=font-file (.FNT exten.) available for display
                           1=totally bitmapped display}
    READLN(Y,DUM);      {not used}

    READLN(Y,grfseg);     {video memory base address: B800H=IBM,
                           B000=all bitmapped}
    READLN(Y,statuscol);  {status,sys setup label color: 15=white, 0=black}
    READLN(Y,DRIVE);      {user-setup area drive:[\subdir]}
    READLN(Y,PATH);       {user-setup area \subdirectory\}
    READLN(Y,MONO);       {monochromatic parameter: 1=monochromatic con-
                           nected to color graphics card, 0=normal}
    READLN(Y,FREQDUALFILE); {filename 2 in both frequency and phase}

    READLN(Y,SGCOLOR);    {2-D spectrograph base monochromatic-mode color}
    READLN(Y,SGBCOLOR);   { "       "       background color }
    READLN(y,SGGCOLOR);   { "       "       grid/axes color }

    READLN(Y, IIRFILTERFILE); {initial recursive filtering filter filename}
    READLN(Y, RECURINFILE);   {  "         "         "     input filename}

    READLN(Y, SCONVUNIT);   {2-D spec SI units level (0=nom., 1=up, 2=down}
    READLN(Y, FCONVUNIT);   {f-domain SI units level (0=nom., 1=up, 2=down}
    READLN(Y, SOUND_STATUS);{0=program sound off, 1=on}
    READLN(Y, CURSOR);      {current cursor type (0=CGA, EGA, 1=mono)}
    READLN(Y, AD_card);         {analog conversion hardware type}
    READLN(Y, DSP_accel);       {DSP accelerator hardware type}
    READLN(Y, DSCOPE_CARD);     {Digital oscilloscope hardware type}
    READLN(Y, SPECANA_CARD);    {Spectrum analyzer hardware type}
    READLN(Y, DT_binary_offset);{Data Trans. binary offset for D/A output}
    READLN(Y, DT_base_addr);    {Data Trans. hardware base I/O address}
    READLN(Y, LSI_25_base_addr);{LSI hardware base I/O address}
    READLN(Y, SWDS_base_addr);  {TI SWDS hardware base memory segment addr}
    READLN(Y, CAC_base_addr);   {CAC hardware base I/O address}
    READLN(Y, ARIEL_base_addr); {ARIEL hardware base I/O address}
    READLN(Y, ARIEL_base_mem_addr);  { " base memory address}
    READLN(Y, BB_base_mem_addr); { Burr-Brown memory base address }
    READLN(Y, proc_type);       {current "DSP Development" chip choice}
    READLN(Y, enable_80286);    {80286 inst. set flag (0=86/88, 1=286/386)}

  { Following arrays contain color values for 2-D spectrographic display,
    where i (0=lowest, 9=highest) is the amplitude level (dB) for a given
    signal point.  1st array corresponds to "C1" choice on data-entry menu,
    2nd to "C2", and 3rd to "G1".  You may place any color values in these
    arrays and alter the color mapping of the corresponding choice in the
    2-D spectrograph display function. }

    for i:=0 to 8 do READLN(Y, color_map_color1[i]);
    for i:=0 to 8 do READLN(Y, color_map_color2[i]);
    for i:=0 to 8 do READLN(Y, color_map_gray[i]);

    READLN(Y, AT_binary_offset);

    READLN(Y,DSCOLOR);      { digital scope waveform color }
    READLN(Y,DSBCOLOR);     {   "       "   background color }
    READLN(Y,DSGCOLOR);     {   "       "   grid color }
    READLN(Y,SACOLOR);      { spectrum analyzer waveform color }
    READLN(Y,SABCOLOR);     {    "        "     background color }
    READLN(Y,SAGCOLOR);     {    "        "     grid color }

    READLN(Y, TI_asm_type); { Texas Inst. assembler type: TAG=0, COFF=1 }
    READLN(Y, insert_mode); { data-entry editor mode: 0=overwrite, 1=insert }

    READLN(Y, LSI_56_base_addr);  { LSI DSP56000 board base address }
    READLN(Y, PLAYBACK_CARD);     { time & 2-D spec. playback hardware }
    READLN(Y, LSI_21_base_addr);  { LSI ADSP-2100 board base address }
    READLN(Y, xfer_scheme);       { transfer scheme for non-supported
                                    hardware: 1=mem mapped, 0 =I/O mapped }
    READLN(Y, OTHER_base_addr);   { non-supported hardware I/O base addr }
    READLN(Y, OTHER_mem_base_addr); {  "             "     mem base addr }
    READLN(Y, ADM_56_base_addr);  { Motorola ADS base address }
    READLN(Y, autoscale);         { dual-waveform autoscaling: 1=enabled }
    READLN(Y, PC_56_base_addr);   { Ariel PC-56 board base address }
    READLN(Y, undo_status);       { editor "undo" function: 1=enabled }
    READLN(Y, MouseType);         { current mouse type }
    READLN(Y, qMous);             { mouse selection from displayed list }
    READLN(Y, LSI_32_base_addr);  { LSI DSP32C board base address }
    READLN(Y, DAL_base_addr);     { Digital Audio Labs DRB1 base address }

    READLN(Y, TITCOLOR);          { text label colors for displays }
    READLN(Y, PHTCOLOR);
    READLN(Y, FRTCOLOR);
    READLN(Y, SPTCOLOR);
    READLN(Y, SGTCOLOR);
    READLN(Y, DSTCOLOR);
    READLN(Y, SATCOLOR);

    FOR J:=0 TO 11 DO BEGIN        { F2-key pop-up menu fields }
        READLN(Y, print_edit[j].field);
        READLN(Y, print_edit[j].xstart);
        READLN(Y, print_edit[j].ystart);
        READLN(Y, print_edit[j].len);
    END;

    READLN(Y, print_edit_cursor_pos); { F2-key pop-up menu cursor pos }

  { Burr-Brown driver info }

    READLN(Y, BB_base_addr);          { I/O base address }
    READLN(Y, module1);               { module plugged into position 1 }
    READLN(Y, module2);               { module plugged into position 2 }
    READLN(Y, module_cnfg);           { configuation of mod1, mod2 }
    READLN(Y, expanded_mem);          { expanded memory mod. detected }
    READLN(Y, pacer);                 { which clock rate to use }

  { TITLE STRINGS USED IN HYPERSIGNAL DISPLAYS }

    READLN(Y, tim_str);               { 'TIME ANALYSIS' }
    READLN(Y, freq_str);              { 'SPECTRA ANALYSIS }
    READLN(Y, phas_str);              { 'PHASE ANALYSIS' }
    READLN(Y, spc_str);               { 'SPECTROGRAPHIC ANALYSIS' }
    READLN(Y, pwr_str);               { 'POWER ' }
    READLN(Y, pole_str);              { 'POLE-ZERO ANALYSIS '}
    READLN(Y, filt_str);              { 'FILTER DESIGN' }
    READLN(Y, fir_str);               { 'FIR '}
    READLN(Y, iir_str);               { 'IIR '}

  { GRAY-LEVEL SHADING PATTERNS USED BY HYPERSIGNAL 2-D SPECTROGRAPH
    WHEN PRINTING TO LASER (OR OTHER MONOCHORMATIC OUTPUT DEVICE) }

    for i:=0 to 15 do begin
        for j:=0 to 7 do READLN(Y, clr_on_black[i,j]);
    end;

    for i:=0 to 15 do begin
        for j:=0 to 7 do READLN(Y, clr_on_white[i,j]);
    end;

    READLN(Y, max_zoom_slew_rate);  { 0-20: maximum mouse slew factor }
    READLN(Y, ARIEL_DATA_OFFSET);    { DSP-16 data memory offset }

    READLN(Y, dsplink);             { LSI DSPLINK mask - on/off }
    READLN(Y, dsplink_type);        { LSI DSPLINK card type }
    READLN(Y, dsplink_ofs);         { LSI DSPLINK A/D offset }
    READLN(Y, dsplink_ofs_scope);   { LSI DSPLINK scope offset }
    READLN(Y, dsplink_ofs_spcana);  { LSI DSPLINK spc. analyzer offset }

    READLN(Y, AIC_CTRL_WORD);       { mode word for DSP boards with AIC }

    READLN(Y, DSP_32C_base_addr);   { Ariel DSP-32C I/O base address }
    READLN(Y, LSI_30_base_addr);    { LSI 'C30 I/O base address }

    READLN(Y, ATT_CTRL_WORD);       { AT&T DSP32C dev. board codec ctrl word }

    READLN(Y, ATT_base_addr);       { AT&T DSP32C dev. board I/O base address }
    READLN(Y, DX2100_seg_addr);     { Logabex ADSP-2100 memory base address }
    READLN(Y, DX2100_reg_off_addr); { Logabex register offset }
    READLN(Y, ASPI_base_addr);      { ASPI Banshee TMS320C30 I/O base address }
    READLN(Y, ASPI_mem_base_addr);  { ASPI Banshee TMS320C30 mem base address }
    READLN(Y, SON_base_addr);       { Sonitech Spirit-30 'C30 I/O base addr }
    READLN(Y, NEC_base_addr);       { NEC DDK 77220 eval. board I/O base addr }
    READLN(Y, NEC_mem_base_addr);   { NEC DDK 77220 eval. board mem base addr }
    READLN(Y, EVM_base_addr);       { Texas Inst. EVM 'C30 I/O base addr }

    DUM:=IORESULT;

    CLOSE(Y);
    DUM:=IORESULT;
{$I+}
end;

{=========== write out Hypersignal configuration file ==========}

procedure config_write(var status: integer);
var DUM:    Integer;
    I,J,K:  Integer;
    dumstr: String;
begin
    STATUS:=0;

{$I-}
    REWRITE(Y);

    WRITELN(Y, ver_str);

    WRITELN(Y,STATEX);
    WRITELN(Y,MEM_STATEY[0]);
    WRITELN(Y,MEM_STATEY[1]);
    WRITELN(Y,MEM_STATEY[2]);
    WRITELN(Y,FILTERFILE);
    WRITELN(Y,CONOUTFILE);
    WRITELN(Y,CONINFILE);

    FOR I:=0 TO 2 DO BEGIN
        FOR J:=0 TO MAX_ENTREE DO BEGIN
            FOR K:=0 TO MAX_FILD DO BEGIN
                WRITELN(Y,FILD[I,J,K]);
            END;
        END;
    END;

    FOR I:=0 TO 2 DO BEGIN
      FOR J:=0 TO MAX_ENTREE DO BEGIN
            FOR K:=0 TO MAX_FIELD DO BEGIN
                WRITELN(Y,FIELD[I,J,K]);
            END;
        END;
    END;

    WRITELN(Y,SER_VAL);
    WRITELN(Y,COM_PORT);
    WRITELN(Y,CONVUNIT);
    WRITELN(Y,dumstr);
    WRITELN(Y,TICOLOR);
    WRITELN(Y,TIBCOLOR);
    WRITELN(Y,TIGCOLOR);
    WRITELN(Y,PHCOLOR);
    WRITELN(Y,PHBCOLOR);
    WRITELN(Y,PHGCOLOR);
    WRITELN(Y,FRCOLOR);
    WRITELN(Y,FRBCOLOR);
