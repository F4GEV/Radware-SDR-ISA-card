


[drivers]
MSACM.echospch=ECHOSPCH.ACM
wavemapper=*.drv
MSACM.imaadpcm=*.acm
MSACM.msadpcm=*.acm
wave=mmsystem.dll
midi=mmsystem.dll

[echodsp.drv]
sbport=220
sbdma=1
midiport=330
dspdma=5
Int=7
joystick=on
wssport=530
dspport=230
Mute=No
LeftMasterVol=32767
RightMasterVol=32767
LeftLineInVol=32767
RightLineInVol=32767
LeftDACVol=32767
RightDACVol=32767
LeftWaveADCMicVol=32767
RightWaveADCMicVol=0
LeftWaveADCLineVol=32767
RightWaveADCLineVol=32767
WaveADCSource=MIC
LeftVoiceADCMicVol=32767
RightVoiceADCMicVol=0
LeftVoiceADCLineVol=32767
RightVoiceADCLineVol=32767
VoiceADCSource=MIC
LeftSynthVol=32767
RightSynthVol=32767

[mci]
sequencer=mciseq.drv
waveaudio=mciwave.drv
cdaudio=mcicda.drv
avivideo=mciavi.drv


