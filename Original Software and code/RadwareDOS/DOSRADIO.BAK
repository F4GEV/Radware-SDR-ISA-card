#include <graphics.h>
#include <ctype.h>
#include <stdio.h>
#include <conio.h>
#include <stdlib.h>

#include <d:\dsp1\radlib.h>

Frequency_Control *Frequency;
Volume_Control *Volume;
FILTER_Control *Filter;
MODE_Control *Mode;
AGC_Control *AGC;
ANTENNA_POWER_Control *RX_Antenna;
PTT_Control *PTT;
MIXER_GAIN_Control *Mixer;
IF_GAIN_Control *Analog_Gain;

main()

{
  char c;

  if (Load_DSP() == -2)                      /* Initialize DSP Card */
  {
    printf("RADWARE.LD file not found");
    abort();
  }
  Frequency = new Frequency_Control();  /* create the frequency control */
  Frequency->Set_Value(690000);         /* Set VCO A to 690 KHz */
  Volume = new Volume_Control();        /* create the volume control */
  Volume->Set_Value(63);                /* Set Volume to Max */
  Filter = new FILTER_Control();        /* create the filter control */
  Filter->Set_Value(4);                 /* Set filter to 2700 Hz */
  Mode = new MODE_Control();            /* create the mode control */
  Mode->Set_Value(1);                   /* Set the mode to AM */
  AGC = new AGC_Control();              /* create the AGC control */
  AGC->Set_Value(0);                    /* set the AGC to OFF */
  PTT = new PTT_Control();              /* create the PTT control */
  PTT->Set_Value(0);                    /* defaults to receive anyway */
  Mixer = new MIXER_GAIN_Control();     /* create mixer control */
  Mixer->Set_Value(0);                  /* turn mixer gain to -10 db */
  Analog_Gain = new IF_GAIN_Control();  /* create analog gain */
  Analog_Gain->Set_Value(0);            /* turn down analog gain */
  RX_Antenna = new ANTENNA_POWER_Control();  /* create the RX DC antenna control*/
  printf("Do you wish to turn on the RX DC Antenna Power? > ");
  do
    c = toupper(getch());
  while (c!='Y' && c!='N');
  if (c == 'Y')
    RX_Antenna->Set_Value(1);          /* turn on antenna power. Antenna defaults to off.*/
  printf("Press any key to quit > ");
  do
  {
    switch(DSPGetMsg())
    {
      case 0   : break;
      case 105 : printf("S meter = %d\n",smeter_string[0]);
                 break;
      default  : //printf("Unknown Message\n");
                 break;
    }
  }
  while (!kbhit());
  delete Frequency;
  delete Volume;
  delete Mode;
  delete Filter;
  delete RX_Antenna;
  delete AGC;
  delete Analog_Gain;
  delete PTT;
  delete Mixer;
}
