#define MAX_MORSE 100
#define VERSION 0x0001

#include <1848.h>

.MODULE/RAM main_routine;

.PORT PSS_data_reg;
.PORT PSS_control_reg;
.PORT PSS_status_reg;
.PORT PSS_dma_reg;
.PORT ram_bank_reg;
.PORT ext_mem_latch;

.PORT SP_address_reg;
.PORT SP_data_reg;
.PORT SP_status_reg;
.PORT SP_pio_reg;
.PORT SP_dmal_reg;
.PORT SP_dmar_reg;
.PORT SP_enable_reg;

.PORT MUSIC0_reg;
.PORT MUSIC_dacl;
.PORT MUSIC1_reg;
.PORT MUSIC_dacr;
.PORT MUSIC_status_reg;
.PORT MUSIC_pc_status_reg;
.PORT MUSIC_divisor_reg;

.PORT SB_data_reg;
.PORT SB_status_reg;
.PORT SB_control_reg;

.PORT MIDI_data_reg;
.PORT MIDI_command_reg;
.PORT MIDI_status_reg;
.PORT MIDI_control_reg;
.PORT MIDI_uart;

.PORT UART_data_reg;
.PORT UART_status_reg;
.PORT UART_control_reg;

.PORT IRQ_status_reg;
.PORT IRQ_enable_reg;
/*.PORT PIO_reg;*/
.PORT PSS_config_reg;
.PORT WSS_config_reg;
.PORT SB_config_reg;
.PORT MIDI_config_reg;
.PORT CD_config_reg;
.PORT UART_config_reg;

.var/dm input_data[512];
.var/dm output_data[512];
.var/dm/ram AGC_Up;
.var/dm/ram AGC_Down;
.var/dm/ram sp_input_place;
.var/dm/ram sp_output_place;
.var/dm/ram data_ready;
.var/dm/ram mute;
.var/dm/ram USB_BUFFER_[256];
.var/dm/ram LSB_BUFFER_[256];
.var/dm/ram reg_1848[22];
.var/dm/ram TalkOn_;
.var/dm/ram AGC_On_;
.var/dm/ram AnalogAGC;
.var/dm/ram CurrentIFGain;
.var/dm/ram DitLength;
.var/dm/ram input_mute;
.var/dm/ram last_data;
.var/dm/ram message_number;
.var/dm/ram message_length;
.var/dm/ram message[256];
.var/dm/ram message_pointer;
.var/dm/ram mode;
.var/dm/ram Monitor;
.var/dm/ram Morse[MAX_MORSE];
.var/dm/ram MorsePosition;
.var/dm/ram NewSetTone;
.var/dm/ram NewIFGain;
.var/dm/ram LogOn_;
.var/dm/ram HannOn_;
.var/dm/ram old_i0;
.var/dm/ram old_i1;
.var/dm/ram old_m0;
.var/dm/ram old_l0;
.var/dm/ram important_message_number;
.var/dm/ram important_message_length;
.var/dm/ram important_message[256];
.var/dm/ram important_message_overflow;
.var/dm/ram out_message_number;
.var/dm/ram out_message_length;
.var/dm/ram out_message[256];
.var/dm/ram out_message_overflow;
.var/dm/ram out_message_pointer;
.var/dm/ram PlotLSBT;
.var/dm/ram PlotUSBT;
.var/dm/ram PlotLSBS;
.var/dm/ram PlotUSBS;
.var/dm/ram SendingMorse;
.var/dm/ram Sample_Rate;
.var/dm/ram New_Sample_Rate;
.var/dm/ram smeter_on;
.var/dm/ram squelch;
.var/dm/ram ibm_data_ready;
.var/dm/ram data_from_ibm;
.var/dm/ram play_voice;
.var/dm/ram fft_time;
.var/dm/ram Mute_Length;
.var/dm/ram winwave;

.GLOBAL winwave;
.GLOBAL TalkOn_;
.GLOBAL USB_BUFFER_;
.GLOBAL LSB_BUFFER_;
.GLOBAL input_data;
.GLOBAL output_data;
.GLOBAL data_ready;
.GLOBAL play_voice;
/*.GLOBAL PIO_reg;*/
.GLOBAL DitLength;
.GLOBAL SendingMorse;
.GLOBAL AnalogAGC;
.GLOBAL AGC_On_;
.GLOBAL AGC_Up;
.GLOBAL AGC_Down;
.GLOBAL fft_time;
.GLOBAL LogOn_;
.GLOBAL HannOn_;
.GLOBAL mode;
.GLOBAL Morse;
.GLOBAL MorsePosition;
.GLOBAL PlotUSBS;
.GLOBAL PlotLSBS;
.GLOBAL PlotUSBT;
.GLOBAL PlotLSBT;
.GLOBAL CurrentIFGain;
.GLOBAL NewSetTone;
.GLOBAL squelch;
.GLOBAL out_message;
.GLOBAL out_message_number;
.GLOBAL out_message_length;
.GLOBAL out_message_overflow;
.GLOBAL out_message_pointer;
.GLOBAL important_message_number;
.GLOBAL important_message_length;
.GLOBAL important_message;
.GLOBAL important_message_overflow;
.GLOBAL message_number;
.GLOBAL message_length;
.GLOBAL message;
.GLOBAL message_pointer;
.GLOBAL ibm_data_ready;
.GLOBAL old_i0;
.GLOBAL NewIFGain;
.GLOBAL old_i1;
.GLOBAL old_l0;
.GLOBAL mute;
.GLOBAL old_m0;
.GLOBAL data_from_ibm;
.GLOBAL input_mute;
.GLOBAL Sample_Rate;
.GLOBAL sp_input_place;
.GLOBAL New_Sample_Rate;
.GLOBAL sp_output_place;
.GLOBAL PSS_data_reg;
.GLOBAL PSS_control_reg;
.GLOBAL PSS_status_reg;
.GLOBAL PSS_dma_reg;
.GLOBAL ram_bank_reg;
.GLOBAL ext_mem_latch;
.GLOBAL Mute_Length;

.GLOBAL SP_address_reg;
.GLOBAL SP_data_reg;
.GLOBAL SP_status_reg;
.GLOBAL SP_pio_reg;
.GLOBAL SP_dmal_reg;
.GLOBAL SP_dmar_reg;
.GLOBAL SP_enable_reg;

.GLOBAL MUSIC0_reg;
.GLOBAL MUSIC_dacl;
.GLOBAL MUSIC1_reg;
.GLOBAL MUSIC_dacr;
.GLOBAL MUSIC_status_reg;
.GLOBAL MUSIC_pc_status_reg;
.GLOBAL MUSIC_divisor_reg;

.GLOBAL SB_data_reg;
.GLOBAL SB_status_reg;
.GLOBAL SB_control_reg;

.GLOBAL MIDI_data_reg;
.GLOBAL MIDI_command_reg;
.GLOBAL MIDI_status_reg;
.GLOBAL MIDI_control_reg;
.GLOBAL MIDI_uart;

.GLOBAL UART_data_reg;
.GLOBAL UART_status_reg;
.GLOBAL UART_control_reg;

.GLOBAL IRQ_status_reg;
.GLOBAL IRQ_enable_reg;
.GLOBAL PSS_config_reg;
.GLOBAL WSS_config_reg;
.GLOBAL SB_config_reg;
.GLOBAL MIDI_config_reg;
.GLOBAL CD_config_reg;
.GLOBAL UART_config_reg;

.external RTTY_Data;
.external RTTY_Data_Pnt;
.external RTTY_Data_Count;
.external GetVolume_;
.external Noise_Level;
.external I_Volume;
.external coeff_custom;

.ENTRY send_msg;
.ENTRY send_important_msg;
.ENTRY put_word;
.ENTRY main_;

#define msg_GET_MSG       1000
#define msg_MORSE_CHAR    1501
#define msg_START_MORSE   1502
#define msg_STOP_MORSE    1503
#define msg_RECIEVE       1504
#define msg_TRANSMIT      1505
#define msg_MODE          1506
#define msg_FILTER        1507
#define msg_IF_GAIN       1508
#define msg_AGC           1509
#define msg_VOLUME        1510
#define msg_PLOT_LSB_S    1511
#define msg_PLOT_USB_S    1512
#define msg_PLOT_LSB_T    1513
#define msg_PLOT_USB_T    1514
#define msg_MUTE          1515
#define msg_MORSE_SPEED   1516
#define msg_SMETER        1517
#define msg_CHANGE_I      1520
#define msg_MORSE_KEY     1522
#define msg_SQUELCH       1523
#define msg_GET_1848      1524
#define msg_AGC_10_DB     1525
#define msg_CUSTOM_FILTER 1526
#define msg_SEND_WINWAVE  1527
#define MSG_SEND_1848 120

.external calculate_modes;
.external ChangeVolume_;
.external SelectFilter_;
.external initFilter_;
.external gain1_,freq1_;
.external smeter_time;
.external InitAGC_;
.external Change_I_;
.external Buffer_Position;

{ ************************************************************************** }

main_:
     call get_word;
     ax0 = dm(PSS_data_reg);     {dummy read to clear out last boot byte}
     {no nesting of interupts, all interupts EDGE sensitive}
     ICNTL=0;

     l0=0;l1=0;l2=0;l3=0;    {all length registers }
     l4=0;l5=0;l6=0;l7=0;    { should be set to 0}
     m0=0;m1=1;m2=0;m3=-1;   {modify registers set }
     m5=1;m6=0;m7=-1;        { to various constants}

     ax0=0x3012;
     dm(0x3ffe) = ax0;     { set two wait states for SoundPort,  }
     ax0=0x0418;           { two waitstates for ROM *was 0x0418* }
     dm(0x3fff) = ax0;

     ax0 = VERSION;          {send version number to PC}
     call put_word;
                  ax0 = Sample_8_KHz;
                  dm(Sample_Rate) = ax0;
                  dm(New_Sample_Rate) = ax0;
                  call SP_init;

/*************************************************************
 The best way to service the Sound Port is by using an
 interrupt service routine off of IRQ2. If not, leave
 interrupts turned off, and just wait for the interrupt bit
 in the ASIC interrupt enable register.

 Probably the most important thing about programming the 1848
 is synchronizing writes to the chip while PEN and CEN are
 turned on.  If they are, you can't just write to the chip
 at any time; your write may conflict with an audio data
 transfer between the ASIC and the 1848.  The only safe way
 to do it is to only write to the 1848 during your 1848
 interrupt service routine; since you aren't using an ISR,
 you should wait until the bit comes on and then write.

 This is why there is code at the top of SP_init that will
 detect if PEN and CEN are turned on and turn them off if they
 are.  If this wasn't there, the 1848 would not be
 reliably initialized.
 *************************************************************/

                  call init_sp_data;

                  ax0 = ^input_data;
                  dm(sp_input_place) = ax0;
                  ax0 = ^output_data;
                  dm(sp_output_place) = ax0;
                  ax0 = 0;
                  dm(data_ready) = ax0;
                  dm(input_mute) = ax0;
                  dm(mute) = ax0;
                  dm(AGC_On_) = ax0;
                  dm(TalkOn_) = ax0;
                  dm(play_voice) = ax0;
                  dm(PlotLSBT) = ax0;
                  dm(PlotUSBT) = ax0;
                  dm(PlotLSBS) = ax0;
                  dm(PlotUSBS) = ax0;
                  dm(out_message_overflow) = ax0;
                  dm(SendingMorse) = ax0;
                  dm(MorsePosition) = ax0;
                  dm(mode) = ax0;
                  dm(HannOn_) = ax0;
                  dm(Buffer_Position) = ax0;
                  dm(NewSetTone) = ax0;
                  dm(RTTY_Data_Count) = ax0;
                  ax0 = 1;
                  dm(smeter_on) = ax0;
                  dm(LogOn_) = ax0;
                  dm(AGC_Up) = ax0;
                  dm(AGC_Down) = ax0;
                  ax0 = ^RTTY_Data;
                  dm(RTTY_Data_Pnt) = ax0;
                  ax0 = 512;
                  dm(Mute_Length) = ax0;
                  ax0 = 15;
                  dm(NewIFGain) = ax0;
                  dm(fft_time) = ax0;
                  ax0 = 4;
                  dm(smeter_time) = ax0;
                  I0 = ^Morse;
                  M0 = 1;
                  L0 = 0;
                  cntr = MAX_MORSE;
                  ar = 0;
                  do clear_morse until CE;
clear_morse:      dm(I0,M0) = ar;
                  ar = -31500;
                  dm(squelch) = ar;
                  ar = 1000;
                  dm(DitLength) = ar;
                  ar = 0x400;
                  call ChangeVolume_;
                  ar = 2000;
                  dm(gain1_) = ar;
                  ar = 8000;
                  dm(freq1_) = ar;
/*                  call initSignal_;
*/                  call initFilter_;
                  ar = 3;
                  call SelectFilter_;
                  call clear_message;
                  call clear_out_message;
                  call clear_important_message;
                  call SP_dma_start;      ! Start the 1848 going
/*                   ax0 = ClkDtaFormat_Sel+MCE;
                   dm(0x3440) = ax0;
                   ax0 = dm(Sample_Rate);
                   dm(0x3448) = ax0;
                   ax0 = 0;
                   dm(0x3440) = ax0;
     call SP_init;
*/                  imask=0x20;
                  ax0=0x2000;             ! Turn on 1848 interrupt
                  dm(IRQ_enable_reg)=ax0;
                  ax1=0x0000;
                  dm(SP_dmal_reg)=ax1;
                  dm(SP_dmar_reg)=ax1;
main_loop:        call check_for_message;
                  ar = dm(data_ready);
                  ar = pass ar;
                  if eq jump main_loop;
                  call calculate_modes;
                  jump main_loop;

check_for_message: ax0 = dm(ibm_data_ready);
                   ar = pass ax0;
                   if eq jump no_data_pending;
                   ax0 = dm(data_from_ibm);
                   ar = 0;
                   dm(ibm_data_ready) = ar;
                   ay0= dm(message_number);
                   ar = pass ay0;
                   if eq jump change_number;
                   ay0 = dm(message_length);
                   ar = pass ay0;
                   if eq jump change_length;
                   i0 = dm(message_pointer);
                   m0 = 1;
                   l0 = 0;
                   dm(i0,m0) = ax0;
                   ax0 = ^message;
                   ar = ax0+ay0;    /* ay0 is still message length */
                   ay1 = i0;
                   ar = ar-ay1;
                   if eq jump end_of_message;
                   dm(message_pointer) = i0;
no_data_pending:   rts;

change_number:     dm(message_number) = ax0;
                   rts;

change_length:     ay0 = 250;
                   ar = ax0-ay0;
                   if ge jump clear_message;
                   dm(message_length) = ax0;
                   ar = pass ax0;
                   if eq jump end_of_message;
                   rts;

end_of_message:    call handle_message; 
clear_message:     ax0 = 0;
                   dm(message_number) = ax0;
                   dm(message_length) = ax0;
                   ax0 = ^message;
                   dm(message_pointer) = ax0;
                   rts;

handle_message:    ax0 = dm(message_number);
                   ax1 = dm(message);
                   ay1 = msg_AGC;
                   ar = ax0-ay1;
                   if eq jump agc_message;
                   ay1 = msg_AGC_10_DB;
                   ar = ax0-ay1;
                   if eq jump agc_10_db_msg;
                   ay1 = msg_CHANGE_I;
                   ar = ax0-ay1;
                   if eq jump change_i_message;
                   ay1 = msg_CUSTOM_FILTER;
                   ar = ax0-ay1;
                   if eq jump custom_filter_message;
                   ay1 = msg_FILTER;
                   ar = ax0-ay1;
                   if eq jump filter_message;
                   ay1 = msg_GET_1848;
                   ar = ax0-ay1;
                   if eq jump get_1848_message;
                   ay1 = msg_IF_GAIN;
                   ar = ax0-ay1;
                   if eq jump if_gain_message;
                   ay1 = msg_MODE;
                   ar = ax0-ay1;
                   if eq jump mode_message;
                   ay1 = msg_MORSE_CHAR;
                   ar = ax0-ay1;
                   if eq jump morse_char_msg;
                   ay1 = msg_MORSE_KEY;
                   ar = ax0-ay1;
                   if eq jump morse_key_message;
                   ay1 = msg_MORSE_SPEED;
                   ar = ax0-ay1;
                   if eq jump morse_speed_msg;
                   ay1 = msg_MUTE;
                   ar = ax0-ay1;
                   if eq jump mute_message;
                   ay1 = msg_PLOT_LSB_T;
                   ar = ax0-ay1;
                   if eq jump plot_lsb_t_msg;
                   ay1 = msg_PLOT_USB_T;
                   ar = ax0-ay1;
                   if eq jump plot_usb_t_msg;
                   ay1 = msg_PLOT_LSB_S;
                   ar = ax0-ay1;
                   if eq jump plot_lsb_s_msg;
                   ay1 = msg_PLOT_USB_S;
                   ar = ax0-ay1;
                   if eq jump plot_usb_s_msg;
                   ay1 = msg_RECIEVE;
                   ar = ax0-ay1;
                   if eq jump recieve_msg;
                   ay1 = msg_SEND_WINWAVE;
                   ar = ax0-ay1;
                   if eq jump send_winwave_message;
                   ay1 = msg_SMETER;
                   ar = ax0-ay1;
                   if eq jump smeter_message;
                   ay1 = msg_SQUELCH;
                   ar = ax0-ay1;
                   if eq jump squelch_message;
                   ay1 = msg_START_MORSE;
                   ar = ax0-ay1;
                   if eq jump start_morse_msg;
                   ay1 = msg_STOP_MORSE;
                   ar = ax0-ay1;
                   if eq jump stop_morse_msg;
                   ay1 = msg_TRANSMIT;
                   ar = ax0-ay1;
                   if eq jump transmit_msg;
                   ay1 = msg_VOLUME;
                   ar = ax0-ay1;
                   if eq jump volume_message;
                   rts;

agc_message:       call InitAGC_;
                   ar = dm(message+1);
                   call ChangeVolume_;
                   ar = dm (message);
                   dm(AGC_On_) = ar;
                   ar = dm(message+2);
                   dm(Monitor) = ar;
                   dm(NewSetTone) = ar;
                   rts;

agc_10_db_msg:     ax0 = dm(message);
                   dm(AGC_Up) = ax0;
                   ax0 = dm(message+1);
                   dm(AGC_Down) = ax0;
                   rts;

change_i_message:  ar = ax1;
                   call Change_I_;
                   rts;

filter_message:    ar = ax1;
                   call SelectFilter_;
                   rts;

clear_out_message: ax0=0;
                   dm(out_message_number) = ax0;
                   dm(out_message_length) = ax0;
                   ax0 = ^out_message;
                   dm(out_message_pointer) = ax0;
                   rts;

clear_important_message: ax0=0;
                         dm(important_message_number) = ax0;
                         dm(important_message_length) = ax0;
                         rts;

custom_filter_message: CNTR = 81;
                       I0 = ^message;
                       M0 = 1;
                       L0 = 0;
                       I4 = ^coeff_custom;
                       M4 = 1;
                       L4 = 0;
                       do custom_filter_loop until CE;
                       AX0 = DM(I0,M0);
custom_filter_loop:    PM(I4,M4) = AX0;
                       rts;

get_1848_message:  ax0 = 0;
                   ay0 = 0x0100;
                   ay1 = 0xFF00;
                   I0 = ^reg_1848;
                   M0 = 1;
                   L0 = 0;
                   cntr = 16;
                   do get_loop until CE;
                   dm(SP_address_reg) = ax0;
                   ax1 = dm(SP_data_reg);
                   ar = ax1 and ay1;
                   dm(I0,M0) = ar;
                   ar = ax0+ay0;
get_loop:          ax0 = ar;
                   call GetVolume_;
                   dm(reg_1848+16) = ar;
                   ar = dm(AGC_On_);
                   dm(reg_1848+17) = ar;
                   ar = dm(Noise_Level);
                   dm(reg_1848+18) = ar;
                   ar = dm(squelch);
                   dm(reg_1848+19) = ar;
                   ar = dm(I_Volume);
                   dm(reg_1848+20) = ar;
                   ar = dm(TalkOn_);
                   dm(reg_1848+21) = ar;
                   ax1 = MSG_SEND_1848;
                   ay1 = 22;
                   I0 = ^reg_1848;
                   call send_msg;
                   ax0 = ClkDtaFormat_Sel+MCE;
                   dm(0x3440) = ax0;
                   ax0 = dm(Sample_Rate);
                   dm(0x3448) = ax0;
                   ax0 = 0;
                   dm(0x3440) = ax0;

                   rts;

if_gain_message:   ax0 = 512;
                   dm(Mute_Length) = ax0;
                   dm(NewIFGain) = ax1;
                   rts;

mode_message:      dm(mode) = ax1;
                   ay0 = 4;
                   ar = ax1-ay0;
!                   if eq jump fm_sample_rate;
                   ay0 = 6;
                   ar = ax1-ay0;
!                   if ge jump fm_sample_rate;
                   ax0 = Sample_8_KHz;
                   ay0 = dm(Sample_Rate);
                   ar = ax0-ay0;
                   if eq jump no_new_sample;
new_sample:        dm(Sample_Rate) = ax0;
                   imask=0x00;
                   call SP_dma_stop;
                   call SP_init;
                   call SP_dma_start;      ! Start the 1848 going
                   imask=0x20;
                   ax0=0x2000;             ! Turn on 1848 interrupt
                   dm(IRQ_enable_reg)=ax0;
                   ax1=0x0000;
                   dm(SP_dmal_reg)=ax1;
                   dm(SP_dmar_reg)=ax1;
no_new_sample:     rts;
fm_sample_rate:    ax0 = Sample_16_KHz;
                   ay0 = dm(Sample_Rate);
                   ar = ax0-ay0;
                   if ne jump new_sample;
                   rts;

morse_char_msg:    I0 = ^Morse;
                   M0 = 1;
                   L0 = 0;
                   do find_end_of_morse until eq;
                   ar = dm(I0,M0);
                   ar = pass ar;
find_end_of_morse: nop;
                   ax0 = i0;
                   ay1 = 1;
                   ar = ax0-ay1;
                   i0 = ar;
                   i1 = ^message;
                   m0 = 1;
                   l0 = 0;
                   l1 = 0;
                   do morse_char_loop until eq;
                   ar = dm(I1,M0);
                   dm(I0,M0) = ar;
                   ar = pass ar;
morse_char_loop:   nop;
                   ax0 = 1;
                   dm(SendingMorse) = ax0;
                   rts;

morse_key_message: ax0 = 2;
                   dm(SendingMorse) = ax0;
set_morse_tones:   ax0 = 2000;
                   dm(gain1_) = ax0;
                   ax0 = 1000;
                   dm(freq1_) = ax0;
                   rts;

morse_speed_msg:   dm(DitLength) = ax1;
                   rts;

mute_message:      ax0 = dm(Monitor);
                   ar = pass ax0;
                   if lt jump end_mute_msg;
                   ar = not ar;
                   dm(Monitor) = ar;
end_mute_msg:      ax0 = 0;
                   dm(NewSetTone) = ax0;
                   rts;

plot_lsb_t_msg:    dm(PlotLSBT) = ax1;
                   rts;

plot_usb_t_msg:    dm(PlotUSBT) = ax1;
                   rts;

plot_lsb_s_msg:    dm(PlotLSBS) = ax1;
                   rts;

plot_usb_s_msg:    dm(PlotUSBS) = ax1;
                   rts;

recieve_msg:       ar = 0;
                   imask = 0;
                   ar = dm(message);
                   dm(TalkOn_) = ar;
                   call InitAGC_;
                   ar = dm(message+1);
                   call ChangeVolume_;
                   ar = dm(message+2);
                   dm(AGC_On_) = ar;
                   ar = dm(message+4);
                   dm(Monitor) = ar;
                   dm(NewSetTone) = ar;
                   ar = dm(message+5);
                   call Change_I_;
                   ax0 = 0;
                   dm(AnalogAGC) = ax0;            
                   call clear_1848_data;
                   ar = dm(message+3);
                   ax0 = 2000;
                   dm(Mute_Length) = ax0;
                   dm(NewIFGain) = ar;
                   imask = 0x20;
                   rts;

send_winwave_message: dm(winwave) = ax1;
                      ar = dm(CurrentIFGain);
                      dm(NewIFGain) = ar;
                      rts;

smeter_message:    dm(smeter_on) = ax1;
                   rts;

squelch_message:   dm(squelch) = ax1;
                   rts;

start_morse_msg:   ax0 = 1;
                   dm(SendingMorse) = ax0;
                   ax0 = 0;
                   dm(MorsePosition) = ax0;
                   dm(Morse) = ax0;
                   jump set_morse_tones;

stop_morse_msg:    ax0 = 0;
                   dm(SendingMorse) = ax0;
                   dm(MorsePosition) = ax0;
                   rts;

transmit_msg:      ar = 1;
                   imask = 0;
                   dm(TalkOn_) = ar;
                   call InitAGC_;
                   ar = dm(message+1);
                   call ChangeVolume_;
                   ar = dm(message+2);
                   dm(AGC_On_) = ar;
                   ar = dm(message+4);
                   dm(Monitor) = ar;
                   dm(NewSetTone) = ar;
                   ar = dm(message+5);
                   call Change_I_;
                   ax0 = 0;
                   dm(AnalogAGC) = ax0;
                   call clear_1848_data;
                   ar = dm(message+3);
                   ax0 = 2000;
                   dm(Mute_Length) = ax0;
                   dm(NewIFGain) = ar;
                   imask = 0x20;
                   rts;

volume_message:    call InitAGC_;
                   ar = ax1;
                   call ChangeVolume_;
                   ax0 = 0;
                   dm(play_voice) = ax0;
                   ax0 = dm(Monitor);
                   ar = pass ax0;
                   if ge jump end_volume_msg;
                   ar = not ar;
                   dm(Monitor) = ar;
                   dm(NewSetTone) = ar;
end_volume_msg:    rts;

                            /* AX1 contains the new message number */
                            /* AY1 contains the new message length */
                            /* I0 contains the pointer to the message */

send_important_msg: ax0 = dm(out_message_number);
                    ar = pass ax0;
                    if eq jump do_send_msg;
                    ax0 = dm(important_message_number);
                    ar = pass ax0;
                    if ne jump important_overflow;
                    dm(important_message_length) = ay1;
                    ar = pass ay1;
                    if eq jump end_send_imp;
                    cntr = ar;
                    i1 = ^important_message;
                    m0 = 1;
                    l0 = 0;
                    l1 = 0;
                    do send_imp_loop until ce;
                    ar = dm(I0,M0);
send_imp_loop:      dm(I1,M0) = ar;
end_send_imp:       dm(important_message_number) = ax1;
                    rts;

important_overflow:  ay0 = dm(important_message_overflow);
                     ar = ay0 + 1;
                     dm(important_message_overflow) = ay0;
                     rts;

send_msg:          ax0 = dm(out_message_number);
                   ar = pass ax0;
                   if ne jump message_overflow;
do_send_msg:       dm(out_message_length) = ay1;
                   ar = pass ay1;
                   if eq jump end_send_msg;
                   cntr = ar;
                   i1 = ^out_message;
                   m0 = 1;
                   l0 = 0;
                   l1 = 0;
                   do send_msg_loop until ce;
                   ar = dm(I0,M0);
/*                   AR = PASS AR;
                   if ne jump send_msg_loop;
                   ar = 100;*/
send_msg_loop:     dm(I1,M0) = ar;
end_send_msg:      dm(out_message_number) = ax1;
                   rts;

message_overflow:  ay0 = dm(out_message_overflow);
                   ar = ay0 + 1;
                   dm(out_message_overflow) = ay0;
                   rts;

put_word: ax1=dm(PSS_status_reg);
          ay0=0x8000;
          ar=ax1 and ay0;
          if eq jump put_word;
          dm(PSS_data_reg) = ax0;
          rts;

/**********************************************************************

 1848 initialization
 
 This will mute the 1848, set the sample rate, and autocalibrate
 the chip.  Note that if you ever want to change the sample rate,
 you can't just set the MCE bit and then turn it off; you have to either
 watch the ACI bit go up and down or delay for about 100 milliseconds.
 
 **********************************************************************/     

clear_1848_data: cntr = 512;
                 i0 = ^input_data;
                 i1 = ^output_data;
                 m0 = 1;
                 l0 = 0;
                 l1 = 0;
                 ar = 0;
                 do clear_1848_loop until ce;
                 dm(i0,m0) = ar;
clear_1848_loop: dm(i1,m0) = ar;
                 rts;

#define SP_ADDR dm(i0,m0)
#define SP_DATA dm(i1,m0)

SP_init:
     ax0=1;
     dm(SP_enable_reg)=ax0;  { Connect 1848 to DSP }

 { Now, wait for a little while to see if the 1848 is turned on
   (that is, PEN and CEN are turned on).  This will ensure that
   the 1848 is reliably initialized. }

     imask=0;
     ay0=0x2000;
     dm(IRQ_enable_reg)=ay0;

     ax0=12500;   /* 10000 */
     af=pass ax0;

dma_detect_loop:
     ax0=dm(IRQ_status_reg);
     ay0=0x2000;
     ar=ax0 and ay0;
     if eq jump dec_counter;

     ax0=0x4900;
     dm(SP_address_reg)=ax0;
     ax0=0;
     dm(SP_data_reg)=ax0;   ! PEN and CEN off

     dm(SP_dmal_reg)=ax0;   ! Clear the ASIC interrupt
     dm(SP_dmar_reg)=ax0;
     jump mute_1848;

dec_counter:
     af=af-1;
     if gt jump dma_detect_loop;

mute_1848:
     ax0=0;
     dm(IRQ_enable_reg)=ax0;

     i0=^SP_address_reg;
     i1=^SP_data_reg;
     m0=0;

     call SP_ini_wait;       { Wait for INIT bit in address reg to go low }

     SP_ADDR=L_Input_Sel+MCE;    { Mute all gain registers in MCE mode }
                                 { for autocalibrate }
     SP_DATA=L_InputMUTE;
     SP_ADDR=R_Input_Sel+MCE;
     SP_DATA=R_InputMUTE;
     SP_ADDR=L_Aux1In_Sel+MCE;
     SP_DATA=L_Aux1InMUTE;
     SP_ADDR=R_Aux1In_Sel+MCE;
     SP_DATA=R_Aux1InMUTE;
     SP_ADDR=L_Aux2In_Sel+MCE;
     SP_DATA=L_Aux2InMUTE;
     SP_ADDR=R_Aux2In_Sel+MCE;
     SP_DATA=R_Aux2InMUTE;
     SP_ADDR=L_Output_Sel+MCE;
     SP_DATA=L_OutputMUTE;
     SP_ADDR=R_Output_Sel+MCE;
     SP_DATA=R_OutputMUTE;
     SP_ADDR=DigMix_Sel+MCE;
     SP_DATA=DigMixMUTE;

     SP_ADDR=Hi_BaseCnt_Sel+MCE;
     SP_DATA=Hi_BaseCnt_Cfg;
     SP_ADDR=Lo_BaseCnt_Sel+MCE;
     SP_DATA=Lo_BaseCnt_Cfg;

     SP_ADDR=IntfConfig_Sel+MCE;    { Test to see if ACAL is turned on}
     ax0=SP_DATA;
     ay0=ACAL;
     ar=ax0 and ay0;
     if ne jump autocal_already_set;

     SP_ADDR=IntfConfig_Sel+MCE;    { If not, turn it on }
     SP_DATA=ACAL;

autocal_already_set:
     SP_ADDR=ClkDtaFormat_Sel+MCE;  {Set up Clock rate & format}
     ax0 = dm(Sample_Rate);
     SP_DATA=ax0; /*ClkDtaFormat_Cfg;*/
     call SP_autocalibrate;         { Perform the autocalibration }
                                    { Watch ACI go up and down }

     SP_ADDR=IntfConfig_Sel+MCE;    { Turn off the ACAL bit }
     SP_DATA=0;
     call SP_autocalibrate;         { Watch ACI again even though ACAL is off }

     SP_ADDR=PinCtrl_Sel;           { Set up all gain registers with initial values }
     SP_DATA=PinCtrl_Cfg;

     SP_ADDR=L_Aux1In_Sel;
     SP_DATA=L_Aux1In_Cfg;
     SP_ADDR=R_Aux1In_Sel;
     SP_DATA=R_Aux1In_Cfg;
     SP_ADDR=L_Aux2In_Sel;
     SP_DATA=L_Aux2In_Cfg;
     SP_ADDR=R_Aux2In_Sel;
     SP_DATA=R_Aux2In_Cfg;
     SP_ADDR=L_Output_Sel;
     SP_DATA=L_Output_Cfg;
     SP_ADDR=R_Output_Sel;
     SP_DATA=R_Output_Cfg;
     SP_ADDR=L_Input_Sel;
     SP_DATA=L_Input_Cfg;
     SP_ADDR=R_Input_Sel;
     SP_DATA=R_Input_Cfg;

     ax0=0x600;
     dm(SP_address_reg)=ax0;
     ax0=dm(SP_data_reg);
     dm(SB_data_reg)=ax0;
/*     ax0 = dm(New_Sample_Rate);
     dm(Sample_Rate) = ax0;
*/     rts;

SP_autocalibrate:
     call SP_ini_wait;

     SP_ADDR=TestInit_Sel;

     ay0=AutoCALInProgress;
autocal_w1:                         {wait for ACI == 1}
     ax0=SP_DATA;
     ar=ax0 and ay0;
     if EQ jump autocal_w1;
 
autocal_w2:                         {wait for ACI == 0}
     ax0=SP_DATA;
     ar=ax0 and ay0;
     if NE jump autocal_w2;
     rts;    

SP_ini_wait:
    ay0=0x8000;      {If this bit is on 1848 is not listening}
iwxx:
    ax0=dm(SP_address_reg);
    ar=ax0 and ay0;
    if NE jump iwxx;
    rts;

SP_dma_start:
    ax0=IntfConfig_Sel;
    dm(SP_address_reg)=ax0;
    ax0=0x0300;           ! Turn on PEN and CEN
    dm(SP_data_reg)=ax0;  ! MCE not required for these two bits
    rts;

SP_dma_stop:
    ax0=IntfConfig_Sel;
    dm(SP_address_reg)=ax0;
    ax0=0x0000;           ! Turn off PEN and CEN
    dm(SP_data_reg)=ax0;  ! MCE not required for these two bits
    rts;

get_word:         ax0 = dm(PSS_status_reg);
                  ay0 = PSS_READ_FULL;
                  ar = ax0 and ay0;
                  if EQ jump end_get_word;
                  ax0 = dm(PSS_data_reg);
end_get_word:     rts;

init_sp_data:     i0 = ^input_data;
                  i1 = ^output_data;
                  m0 = 1;
                  l0 = 0;
                  cntr = 512;
                  ax0 = 0;
                  do init_data_loop until CE;
                  dm(i0,m0) = ax0;
init_data_loop:   dm(i1,m0) = ax0;
                  rts;


.ENDMOD;


